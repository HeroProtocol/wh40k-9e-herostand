        <profile name="Master of Prescience" id="3446-36a8-bf48-970b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the battle round, you can select one friendly ULTRAMARINES CORE or ULTRAMARINES CHARACTER unit within 6&quot; of this model. Until the end of that battle round, when resolving an attack against that unit, subtract 1 from that attack’s hit roll.</characteristic>
          </characteristics>
        </profile>
