      <profiles>
        <profile name="Chaplain Cassius" id="3985-0a60-1589-c65e" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">2+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">5</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">4</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">3</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Inspired Retribution (Aura)" id="60e0-dcd0-cdee-505d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ULTRAMARINES CORE or ULTRAMARINES CHARACTER unit is within 6&quot; of this model, each time a model in that unit is destroyed by a melee attack, roll one D6: on a 6, the enemy unit that made the attack that destroyed your model suffers 1 mortal wound after it has fought.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spiritual Leaders (Aura)" id="5803-c995-2379-c79a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ULTRAMARINES CORE unit is within 6&quot; of this model, models in that unit can use this model’s Leadership characteristic instead of their own.</characteristic>
          </characteristics>
        </profile>
        <profile name="Priest (Chaplain Cassius)" id="4286-3b18-e0f7-bcc8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model knows the Litany of Hate and two other litanies from the Litanies of Battle (see Codex: Space Marines). In your Command phase, if this model is on the battlefield, it can recite two litanies it knows that have not already been recited by a friendly model this turn. Roll one D6 for each: on a 3+, the recited litany is inspiring and takes effect until the start of your next Command phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
