      <profiles>
        <profile name="Big an&apos; Stompy" id="fe54-927e-8e39-b7ae" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to declare a charge in a turn in which it Fell Back.  Each time this model makes a Normal Move, Advances, or Falls Back, it can be moved accross other models (excluding MONSTER and VEHICLE models) as if they were not there, and when it does so it can be moved within Engagement Range of such models, but cannot finish it move within Engagement Range of any of them.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gorkanaut [1] (13+ Wounds)" id="7651-b43a-3f21-64f1" hidden="false" page="111" publicationId="11b5-77b9-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
