        <profile name="Snagged" id="8ebb-9d08-539c-729c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack with its stikka kannon, if an enemy VEHICLE or MONSTER model (excluding TITANIC or AIRCRAFT models) loses any wounds as a result of that attack, roll one D6: on a 4+, that enemy model cannot finish any type of move more than 12&quot; from this model until the start of your next turn. If this model moves for any reason, or is destroyed, this effect ends.</characteristic>
          </characteristics>
        </profile>
      </profiles>
