            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="-1"/>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name=" Scrap Points" typeId="932a-ae3d-c6c7-6938" value="0"/>
          </costs>
          <profiles>
            <profile name="Kult of Speed" id="5068-5569-58a4-f497" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Use this Stratagem when choosing your army. Pick an ORK Detachment from your army to be a Kult of Speed Specialist Detachment. SPEED FREEKS in that Detachment gain the KULT OF SPEED keyword.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dread Waaagh!" id="8f45-9eef-7552-026c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
