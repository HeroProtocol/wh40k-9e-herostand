            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">2</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">6</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">6+</characteristic>
          </characteristics>
        </profile>
        <profile name="Ghazghkull’s Waaagh! Banner (Aura)" id="78de-9f04-f324-6d66" hidden="false" publicationId="52c4-39c0-ae97-d4dc" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly GOFF ORKS unit is within 3&quot; of this model, and this model is within 3&quot; of a friendly GHAZGHKULL THRAKA unit, each time a model in that friendly GOFF ORKS unit would lose a wound, roll one D6; on a 6, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Suspiciously Lucky" id="5ac2-6550-df2b-f4e8" hidden="false" publicationId="52c4-39c0-ae97-d4dc" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 2+ Invulnerable save.  If an invulnerable save made for this model is failed, this ability has no effect for the rest of the battle.</characteristic>
          </characteristics>
        </profile>
        <profile name="Accidental Figurehead (Aura)" id="3ccd-0453-f899-6ba1" hidden="false" publicationId="52c4-39c0-ae97-d4dc" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly GOFF GRETCHIN unit is within 12&quot; of this model, models in that unit can use this model&apos;s Leadership characteristic instead of their own.</characteristic>
          </characteristics>
        </profile>
        <profile name="Keep Up!" id="eb47-3882-a19f-ade4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is within 3&quot; of a friendly GHAZGHKULL THRAKA unit, add 2&quot; to this model&apos;s Move characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="‘Da Boss’ Best Grot" id="7874-f29d-1aa0-582b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, then if GHAZGHKULL THRAKA is included in a Detachment, MAKARI can be included in that Detachment without taking up an additional Battlefield Role slot.</characteristic>
          </characteristics>
        </profile>
      </profiles>
