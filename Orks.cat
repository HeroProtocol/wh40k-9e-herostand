        <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">6</characteristic>
        <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">6+</characteristic>
      </characteristics>
    </profile>
    <profile name="Pyromaniaks" id="c072-3cd4-9064-7d36" hidden="false" page="97" publicationId="11b5-77b9-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If an enemy unit is destroyed by an attack made with a burna by this unit, until your next turn, each time a Morale test is taken for this unit, it is automatically passed.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grot Gunner and Targetin&apos; Squig" id="1ae9-9257-6c92-f428" hidden="false" page="103" publicationId="11b5-77b9-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model from this unit makes an attack with a kustom shokk rifle, treat that model as having a Ballistic Skill characteristic of 3+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shokk Tunnel" id="3ae3-e8a1-b6a2-6518" hidden="false" page="103" publicationId="11b5-77b9-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If an Advance roll made for this unit is 4+, you can remove this unit from the battlefield and set it up again anywhere on the battlefield that is more than 9&quot; away from any enemy models and roll one D6; on a 4+ this unit suffers D3 mortal wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="Kustom Shokk Rifle" id="b5c0-c388-1a71-14e2" hidden="false" page="103" publicationId="11b5-77b9-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2</characteristic>
        <characteristic name="S" typeId="59b1-319e-ec13-d466">8</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-3</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D6</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">If any unmodified hit rolls of 1 are made for attacks with this weapon, the bearer&apos;s unit suffers 1 mortal wound after shooting with this weapon. Each time an attack is made with this weapon, an unmodified wound roll of 6 inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
