        <profile name="The Boss is Watchin&apos; (Aura)" id="9d50-5568-fdbd-ea17" hidden="false" page="84" publicationId="11b5-77b9-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ORKS unit is within 6&quot; of this model, each time a combat Attrition test is taken for that unit, ignore any or all modifiers.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prophet of Gork and Mork" id="bf8c-2628-fb11-0dd4" hidden="false" page="84" publicationId="11b5-77b9-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save, in addition, this model can only lose a maximum of 4 wounds in each phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Goffs is da Best" id="198f-c867-a3fb-4c7f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly GOFF CORE or GOFF CHARACTER unit is within 6&quot; of this model, each time a model in that unit makes a melee attack, you can re-roll the hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Grand Warlord" id="cbf9-e775-c983-035b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model is included in your army, it must be your WARLORD.</characteristic>
          </characteristics>
        </profile>
