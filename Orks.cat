        <profile name="Sawbonez" id="b5e2-d278-cab3-d262" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this model can attempt surgery on one friendly &lt;CLAN&gt; INFANTRY or &lt;CLAN&gt; BIKER model within 3&quot;. If it does, roll one D6; on a 1 that friendly model loses 1 wound, otherwise it regains D3 lost wounds. Each model can only have surgery attempted on it once per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
