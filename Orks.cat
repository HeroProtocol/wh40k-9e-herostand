      <rules>
        <rule name="Explodes (6&quot;/3D6/D6)" id="aa06-51bf-d4ea-12ab" hidden="false" page="202" publicationId="7573-8d1b-acdf-2de8">
          <description>When this model is destroyed, roll one D6 before any embarked models disembark and before removing it from play. On a 6 it explodes and each unit within 3D6&quot; suffers D6 mortal wounds.</description>
        </rule>
      </rules>
