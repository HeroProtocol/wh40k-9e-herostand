          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit of Artillery and its accompanying Grot Gunners must be deployed with each model within 3&quot; of at least one other model from their unit.  From that point on, each Artillery model and 2 or 5 model group of Grot Gunners act as a single unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Take Cover" id="2052-f783-b1e4-ac53" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Grot Gunners can only be targeted in the shooting phase if they are the closest enemy unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
