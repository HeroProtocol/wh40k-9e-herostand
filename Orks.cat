    <profile name="Waaagh! (Biker)" id="6829-dbf1-bf22-c9e5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly Ork Infantry and Biker units within 6&quot; of this model at the start of the Charge phase can charge even if they Advanced this turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Throat Slittas" id="4350-a8e0-753d-fa9a" hidden="false" page="87,100" publicationId="11b5-77b9-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes a melee attack, if it is within 1&quot; of a terrain feature, add 1 to that attack&apos;s wound roll.</characteristic>
      </characteristics>
      <modifiers>
        <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="Each time a model in this unit makes a melee attack, if it is within 1&quot; of an open Hatchway or if it has used a distraction grot, add 1 to that attack&apos;s wound roll.">
          <conditions>
            <condition childId="a207-a133-6adb-25f3" field="forces" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="greaterThan" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
    </profile>
    <profile name="Explodes (4+/D6&quot;/D3)" id="5e32-7bb6-7a93-a0b6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
