        <profile name="Too Tuff for Deff" id="f6e7-1ed9-1d82-c969" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save. Each time this model would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Breakin&apos; Heads" id="c3f2-2ffd-bc2a-2269" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a GOFF unit fails a Morale test while it is within 3&quot; of a friendly model with this ability, this model can restore order with a brutal display of violence. If they do so, the unit suffers D3 mortal wounds but the Morale test is then considered to have been passed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Waaagh!" id="f9c5-777d-7624-2235" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly GOFF INFANTRY units within 6&quot; of this model at the start of the Charge phase can charge even if they Advanced this turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
