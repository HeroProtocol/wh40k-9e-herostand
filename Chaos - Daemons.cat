        <profile name="The Endless Gift" id="6326-3381-ba9a-b0da" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Command phase, the bearer regains up to a number of wounds equal to the current battle round number.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Fatal Caress" id="a3a9-bc3d-7cf8-590e" collective="false" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Fatal Caress" id="2b13-8832-3ae5-7814" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer makes a melee attack, on an unmodifed successful wound roll of 5+, invulnerable saving throws cannot be made against that attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
