                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- If this model is a TZEENTCH, NURGLE or SLAANESH model, this model knows one additional psychic power from any discipline they have access to. 
- If this model is a KHORNE model, add 1 to that model&apos;s Strength characteristic. 
- If this model is a TZEENTCH, NURGLE or SLAANESH model, once per battle, after successfully manifesting a psychic power, this model can regain up to D3 lost wounds.
- If this model is a KHORNE model, once per battle, after this model destroys an enemy CHARACTER model 
with a melee attack, this model can regain up to D3 lost wounds.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Portal Keeper" id="c74c-56ee-7ca9-7abf" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
