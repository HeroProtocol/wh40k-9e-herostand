                      <profiles>
                        <profile name="Exalted Servant" id="7ee2-4cd6-98d8-7c50" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can use the Exalted Daemon Requisition (pg 1 32) once for ORP, but if you do so, you must select this model. if this model is not eligible for that Requisition it cannot  be given this Reward. When you do so, that Requisition 
can be used to give this model an additional Exalted ability. Adjust that model&apos;s Power Rating as appropriate 
and make of note of this on its crusade card. You cannot use this ability if doing so would ca;se your total Power Level to exceed your Crusade force&apos;s Supply Limit.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
