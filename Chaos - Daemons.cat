      <selectionEntries>
        <selectionEntry name="Blood-drinker Talisman" id="ec1c-a239-2b01-5db3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b310-9bdc-c856-f28d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Blood-drinker Talisman" id="f80c-2253-13ef-e6ed" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer fights, after resolving its attacks, roll one D6 for each enemy model that was destroyed by those attacks. On a 5+, the bearer regains one lost wound. The bearer cannot regain more than 6 lost wounds in each Fight phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rune of Brass" id="1ab1-236d-c79e-a574" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8b0e-ef0d-e369-fa62" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Rune of Brass (Aura)" id="9082-907d-38ac-a3c4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy PSYKER is within 12&quot; of the bearer:
- Each time a Psychic test is taken for that unit, it suffers Perils of the Warp on any dice roll that includes a double, instead of only a double 1 or double 6.
- Each time that model suffers Perils of the Warp, it suffers D6 mortal wounds instead of D3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="A&apos;rgath, the King of Blades" id="d03c-ff61-c3af-afe5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="502c-5075-ab32-b39b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="A&apos;rgath, the King of Blades" id="4b3b-a047-d716-5bc8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Select one melee weapon the bearer is equipped with.
- Add 1 to the Damage characteristic of that weapon.
- Each time the bearer makes a melee attack with that weapon, you can ignore any or all modifiers to that attack&apos;s hit roll and any or all modifiers to that attack&apos;s wound roll.
- That weapon is now considered a Relic for all rules purposes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armour of Scorn" id="6213-20c5-0cc6-7f93" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2ee8-991f-b9cf-c37a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="3b77-decb-d468-6bcc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Armour of Scorn" id="9934-e44c-4f86-1f1e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time an attack with a Damage characteristic of 1 is allocated to the bearer, add 1 to any saving throw made against that attack (even though it is a Daemonic saving throw).
- Each time the bearer would lose a wound as a result of a mortal wound in the Psychic phase, roll one D6: on a 4+, that wound is not lost.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
