      <profiles>
        <profile name="Attention Seeker" id="b897-7aa5-28f9-0b7f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit can perform Heroic Interventions as if it were a CHARACTER unit. This unit is eligible to perform a Heroic Intevention if it is within 6&quot; horizontally and 5&quot; vertically of any enemy unit, instead of 3&quot; horizontally and 5&quot; vertically. Each time this unit performs a Heroic Intervention move, it can move up to 6&quot;. All other rules for Heroic Interventions still apply.</characteristic>
          </characteristics>
        </profile>
        <profile name="Grotesque Regeneration" id="7b5a-a4cd-d277-9e2b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of each phase, if a model in this unit has lost any wounds but was not destroyed, that model regains all of its lost wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gooey Demise" id="854d-54db-81f7-87d5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit is destroyed, roll one D6 before removing it from play. On a 6 it explodes, and each enemy unit within 3&quot; suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
