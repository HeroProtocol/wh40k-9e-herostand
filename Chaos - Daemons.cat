        <profile name="Emissary of the Great Mutator (Aura)" id="a048-61e0-e3cc-328c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly TZEENTCH DAEMON unit is within 9&quot; of this model, models in that unit can use this model&apos;s Leadership characteristic instead of their own.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mantle of Twisted Fates" id="fc34-7723-afc0-33a5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy model successfully manifest a psychic power while within 18&quot; of this model, roll one D6; on a 4+, that enemy model suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Spiteful Demise" id="7c03-d896-6d32-07a8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model is destroyed, roll a D6 before removing it from play; on a 4+ each unit within D6&quot; suffers D6 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Magics" id="b505-2eb7-deb6-1423" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Psychic test is taken for this model, add 1 to the result. If this model has 14 or more wounds remaining, add 2 to the result.</characteristic>
          </characteristics>
        </profile>
