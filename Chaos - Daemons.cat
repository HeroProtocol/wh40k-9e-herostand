          </costs>
          <profiles>
            <profile name="The Forbidden Gem" id="876c-a0bc-73f2-d495" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one enemy unit within 12&quot; of the bearer. Until the start of your next Command phase, any aura abilities that unit has have no effect.</characteristic>
