      </characteristics>
    </profile>
    <profile name="Daemon Lord of Slaanesh (Aura)" id="131c-7ac3-2d87-0340" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly LEGIONES DAEMONICA SLAANESH CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Herald of Tzeentch (Aura)" id="ee64-7cdc-55c5-c552" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly LEGIONES DAEMONICA TZEENTCH CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, you can re-roll a wound roll of 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Herald of Nurgle (Aura)" id="f74d-e06e-dc63-f109" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly LEGIONES DAEMONICA NURGLE CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, you can re-roll a wound roll of 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scything Impact" id="ae27-f937-46db-e468" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model finishes a charge move:
- Roll four D6 for each enemy unit within Engagement Range of this model. For each 5, that enemy unit suffers 1 mortal wound.
- Until the end of the turn, add 2 to this model&apos;s Attacks characteristic.</characteristic>
      </characteristics>
    </profile>
    <profile name="Herald of Slaanesh (Aura)" id="d0e6-b9ec-bab1-894b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly LEGIONES DAEMONICA SLAANESH CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, you can re-roll a wound roll of 1.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mesmerising Form" id="27ee-b576-e620-bed8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against this model, subtract 1 from that attack&apos;s hit roll.</characteristic>
      </characteristics>
    </profile>
