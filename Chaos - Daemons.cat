                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Malediction. If manifested, select one enemy unit within 18&quot; of and visible to this PSYKER. Until the start of your next Psychic phase, subtract 1 from the Toughness characteristic of models in that unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virulent Blessing" id="615b-3c7a-aec1-014f" collective="false" hidden="false" import="true" page="69" publicationId="28ec-711c-pubN99666" type="upgrade">
