          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model would lose a wound from an attack with a Damage characteristic of 1, roll one D6; on a 4+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Putrid Demise" id="c09f-9fdd-3aa5-a56f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model is destroyed, roll one D6 before removing it from play; on a 4+, each unit (excluding NURGLE units) within D3&quot; suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cor&apos;bax Utterblight 2 (4-6 wounds remaining)" id="4975-b0b9-a890-d55d" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
