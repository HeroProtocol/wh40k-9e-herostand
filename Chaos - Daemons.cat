      <profiles>
        <profile name="1 - Extra Limbs" id="a81d-be14-8bbe-1dd3" hidden="false" typeId="b764-10e0-373e-7176" typeName="Boon of Change - D3 Roll">
          <characteristics>
            <characteristic name="Effect" typeId="fa1f-c762-e6c4-1582">Add 2&quot; to the Move characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 - Mystic Strength" id="e7ea-5226-2b60-79e7" hidden="false" typeId="b764-10e0-373e-7176" typeName="Boon of Change - D3 Roll">
          <characteristics>
            <characteristic name="Effect" typeId="fa1f-c762-e6c4-1582">Add 1 to the Strength characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 - Iron Skin" id="13b1-8bea-d19b-4efe" hidden="false" typeId="b764-10e0-373e-7176" typeName="Boon of Change - D3 Roll">
          <characteristics>
            <characteristic name="Effect" typeId="fa1f-c762-e6c4-1582">Add 1 to the Toughness characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Boon of Change" id="0a92-3cc9-b2e1-1eba" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Blessing. If manifested, select one friendly LEGIONES DAEMONICA TZEENTCH unit within 18&quot; of this PSYKER and roll one D3. Until the start of your next Psychic phase, that unit gains the relevant bonus from the table.

If the result of the Psychic test was 9 or more, you can select which result applies instead of rolling a D3.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Bolt of Change" id="ce03-1df5-aa8d-80b8" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="5311-3c3c-2958-61b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
