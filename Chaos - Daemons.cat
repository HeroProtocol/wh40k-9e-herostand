                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time this model makes an attack against an enemy WARLORD or a unit that has a higher Crusade 
points total than this model, add I to that attack&apos;s wound roll. 
- Each time this model destroys an enemy WARLORD or a unit that has a higher Crusade points total than this 
model, it gains I additional experience point at the end of the battle.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
