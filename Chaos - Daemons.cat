                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made against a VEHICLE or MONSTER UNIT with this weapon profile, that attack has a Strength characteristic of x2 and a Damage characteristic of D3+3.</characteristic>
              </characteristics>
            </profile>
            <profile name="Skullreaver - Sweeping blow" id="d918-c5b0-5fb9-7be1" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
