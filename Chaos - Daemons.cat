                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">3</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an enemy model loses any wounds as a result of an attack made with this weapon, until the end of the battle, each time that model makes a melee attack, subtract 1 from that attack&apos;s hit roll and wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
