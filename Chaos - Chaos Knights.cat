                <selectionEntryGroup name="Chaos Knight Suit" id="8574-3903-b687-0089" collective="false" hidden="false" import="true">
                  <selectionEntries>
                    <selectionEntry name="1. Bestial Onslaught" id="50f0-f9c2-2df7-800d" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="9dc4-54cf-b979-0745" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="1. Bestial Onslaught" id="b905-d923-e0da-dc83" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model has finished making a charge move, you can select one enemy unit within 1&quot; of it and roll one D6, adding 4 to the result if this model is TITANIC. On a 3+, that unit suffers D3 mortal wounds; on a 6+, that unit suffers 3 mortal wounds.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="2. Graven Hull" id="30f7-02be-4ad0-171e" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="39a4-2acb-5f90-de5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="2. Graven Hull" id="494d-8ec8-9a3e-e599" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack with a Damage characteristic of 1 is allocated to this model, add 4 to any armour saving throws taken against that attack.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="3. Unholy Vitality" id="69b9-8512-8739-f87a" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="128f-1ddb-09d0-4b77" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="3. Unholy Vitality" id="5e22-abdd-5280-4343" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">wounds remaining for the purposes of determining what its characteristics are. If this model has any rule that would let it double the number of wounds it has remaining for the purposes of determining what characteristics onits profile to use (e.g. the Blasphemous Engine Relic, page 76), triple the number of wounds it has remaining instead. * You can re-roll failed Out of Action tests taken for this model.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="4. Warding Totems" id="1deb-6274-c51c-454f" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="aa45-d385-f0b9-942b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="4. Warding Totems" id="0410-dcf4-5f46-8167" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once perturn, this unit can attempt to Deny the Witch as if it were a PSYKER. If this unit is already a PSYKER, or already has an ability that lets it attempt to Deny the Witch (e.g. Warp-haunted Hull), then in each enemy Psychic phase, it can attempt to Deny the Witch one additional time.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="5. Heedless of Destruction" id="c78d-2ffc-e643-dcdf" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="65ca-6628-56d7-7f3b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="5. Heedless of Destruction" id="33e3-077c-e91a-0dae" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model does not suffer the penalty incurred to its hit rolls for firing Heavy weapons at enemy units that are within Engagement Range of it. * This model can make attacks with Blast weapons against units within Engagement Range of it, however, each time it does so, on an unmodified hit roll of 1, this model suffers 1 mortal wound afterit has resolved all of its shooting attacks.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="6. Idol of Annihilation" id="005d-4228-25b0-7204" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="6681-3de0-4ad6-c28a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
