                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a melee attack, you can ignore any or all modifiers to its Weapon Skill characteristic or hit rolls. * Each time this model makes a melee attack, you can 
re-roll ahit roll of 1.</characteristic>
                          </characteristics>
