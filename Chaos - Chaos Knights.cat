            <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">6</characteristic>
            <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made with this weapon profile, subtract 1 from that attack&apos;s hit roll. Each time an attack is made with this weapon profile, if that attack targets a VEHICLE or MONSTER unit, add 2 to the Damage characteristic of that attack.</characteristic>
          </characteristics>
        </profile>
