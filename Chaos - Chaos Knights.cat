                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, if this model is on the battlefield, when you use a Chaos Knights Wargear Stratagem (pg 69), that Stratagem costs 0 Command points so long as you select this model for that Stratagem</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
