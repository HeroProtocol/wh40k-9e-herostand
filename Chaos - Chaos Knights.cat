          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer loses a wound as the result of a mortal wound, unless that wound was inflicted by the Daemonic Surge ability, roll one D6: on a 4+ that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Soul-Raptor (Dreaded)" id="aa97-8a68-f3fd-ceeb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whilst an enemy unit is within Dread range of the bearer, each time a model flees from that unit, the bearer regains one lost wound (to a maximum of 3 regained wounds per phase).</characteristic>
          </characteristics>
        </profile>
      </profiles>
