              <characteristics>
                <characteristic name="Standard" typeId="8415-27e8-bbac-4ee6">Each time a melee attack is made against this model, subtract 1 from that attack&apos;s hit roll and subtract 1 from that attack&apos;s wound roll.</characteristic>
