        <entryLink name="Battle Honours (Crusade - BRB)" id="c113-2c38-0528-e1a7" collective="false" hidden="false" import="true" targetId="3219-c04d-a4d0-69ef" type="selectionEntryGroup"/>
      </entryLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
