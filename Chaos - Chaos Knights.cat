                      </costs>
                      <profiles>
                        <profile name="3-4 Relentless Destroyer" id="88fb-d261-7d27-b536" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model can ignore any or all modifiers to its Advance rolls and charge rolls. * Each time this model makes a consolidation move, it can move an extra 3&quot;.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="5-6 Gloryseeker" id="f0b0-1183-b573-c146" collective="false" hidden="false" import="true" type="upgrade">
