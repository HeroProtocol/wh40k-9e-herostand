          <profiles>
            <profile name="Dread Hunter" id="253a-9a71-c9e1-b2f6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the start of your Shooting phase, this WARLORD can make a killing strike. If it does so, select one ranged weapon this WARLORD is equipped with. Until the end of the phase, each time an attack is made with that weapon, you can re-roll the hit roll, you can re-roll the wound roll and you can add 1 to the Damage characteristic of that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
