      <infoLinks>
        <infoLink name="Vanguard Predator" id="954a-6ac1-cf6b-b91d" hidden="false" targetId="bc40-384b-8bf8-f27e" type="profile">
          <modifiers>
            <modifier field="page" type="set" value="106"/>
            <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="append" value="After this unit is set up, if it is equipped with an infestation node, you can set up one friendly &lt;HIVE FLEET&gt; Infestation Node marker on the battlefield within 1&quot; of this unit."/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
