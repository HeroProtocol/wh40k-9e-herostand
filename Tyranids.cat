                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Hyper-adaptation (Hydra)" id="d221-d920-e248-c120" hidden="false" page="59" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
