        <infoLink name="Synapse (Aura)" id="327b-487b-e7bf-3657" hidden="false" targetId="1f08-bd8f-43a3-ce1b" type="profile"/>
        <infoLink name="Shadow in the Warp (Aura)" id="9147-ac58-3786-bb70" hidden="false" targetId="f587-afe6-7bbe-4eac" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Shrouding Spores (Aura)" id="c3a7-e443-af13-d6c2" hidden="false" page="217" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;HIVE FLEET&gt; unit that is not TITANIC is within 6&quot; of this model, each time a ranged attack is made against that unit, subtract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prey Adaption" id="8e02-bdab-c2bb-700f" hidden="false" page="217" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If an enemy model is destroyed within 3&quot; of this model, then at the end of that phase, this model gains the following ability until the end of the battle: &apos;Prey Adaption (Aura): While a friendly &lt;HIVE FLEET&gt; unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a wound roll of 1.&apos;</characteristic>
          </characteristics>
        </profile>
        <profile name="Enhanced Toxic Miasma" id="3449-4605-b24b-61ce" hidden="false" page="217" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the Fight phase, roll one D6 for each enemy unit within Engagement Range of this model; on a 4+, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Malanthrope" id="a5a3-e203-dad2-7f78" hidden="false" page="217" publicationId="7573-8d1b-acdf-2de8" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">5&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">4+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">4+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">5</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">9</characteristic>
