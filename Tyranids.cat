              <profiles>
                <profile name="Hyper-aggression" id="86b2-75d9-0ed3-23ac" hidden="false" page="53" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation fights, if it made a charge move, was charged, or performed a Heroic Intervention this turn, then until that fight is resolved, add 1 to the Strength characteristic of models in that unit.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="ed98-6a58-e87d-0c0d" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Hyper-adaptation (Behemoth)" id="8c5d-7150-ed33-c422" hidden="false" page="53" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can swap this hive fleet&apos;s Adaptive rule for one of the Hunt Biomorphologies or Lurk Biomorphologies on page 61.</characteristic>
                  </characteristics>
                  <modifiers>
