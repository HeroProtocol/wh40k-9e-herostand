        <profile name="Mawloc [3] (1-3 wounds)" id="54ef-ec36-f3dc-1b12" hidden="false" page="109" publicationId="7150-5917-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
