            <characteristic name="W" typeId="f330-5e6e-4110-0978">N/A</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">6</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="Hierophant Bio-titan  [3] (1-9 wounds)" id="fad7-1fb5-f883-e5dd" hidden="false" page="223" publicationId="7573-8d1b-acdf-2de8" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">5+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">5+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">8</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">8</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">N/A</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">6</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="Titanic (Hierophant)" id="cee0-0314-bcee-dac7" hidden="false" page="223" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to declare a charge in a turn in which it Fell Back. Each time this model makes a Normal Move, Advances or Falls Back, it can be moved across other models (excluding MONSTER and VEHICLE models) as if they were not there, and when it does it can be moved within Engagement Range of such models, but cannot finish its move within Engagement Range of any of them.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hypertoxic Poison Cloud" id="889b-aa22-b792-36f8" hidden="false" page="223" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the Fight phase, roll one D6 for each enemy model in Engagment Range of this model; on a 5+, that model&apos;s unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hierophant" id="ed09-b341-687f-3757" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">20 &lt;HIVE FLEET&gt; INFANTRY models. Each model with a Wounds characteristic of more than 1 takes up the space of 2 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="*Designers Note" id="547e-4154-2376-52b4" hidden="false" page="223" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model does not have a base, before deployment, both players must agree the footprint of this model&apos;s &apos;base&apos; in the same way they would for an Area Terrain feature. We suggest that an imaginary straight line should be drawn from each point on this model which would touch the battlefield when it is placed on a flat surface. The area within these lines should be considered to be the model&apos;s &apos;base&apos;.

If the model has been posed with one or more of its legs raised, agree with your opponent the point where that leg would touch the battlefield, and use this as this to advise the shape of the model&apos;s &apos;base&apos;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
