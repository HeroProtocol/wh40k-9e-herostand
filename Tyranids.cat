        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">3</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">If the bearer is equipped with two wrecker claws, each time an attack is made with this weapon, you can re-roll the hit roll. Each time an attack made with this weapon is allocated to a VEHICLE or MONSTER model, that attack has a Damage characteristic of 5.</characteristic>
      </characteristics>
    </profile>
    <profile name="Grasping Tail" id="c4df-752f-d415-9f56" hidden="false" page="217" publicationId="7573-8d1b-acdf-2de8" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
