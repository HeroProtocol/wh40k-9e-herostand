    <profile name="Death from Above" id="119a-d63d-eb46-2dc9" hidden="false" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, you can set up this model high in the skies instead of setting it up on the battlefield. If you do so, then during the Reinforcements step of one of your Movement phases, you can set up this model anywhere on the battlefield that is more than 9&quot; away from any enemy models, and, until the end of the turn, you can re-roll charge rolls made for this model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Carnifex Scything Talon" id="b12a-3800-44bc-332a" hidden="false" page="MelArm" publicationId="7150-5917-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
