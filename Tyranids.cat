              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model shoots, after it has finished making its attacks, select one unit that was hit by one or more of those attacks. Roll one D6: on a 2+, that unit suffers D3 mortal wounds.</characteristic>
              </characteristics>
            </profile>
          </profiles>
