            <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp Blast" id="f2c4-071f-98a8-66e1" hidden="false" page="105" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit attempts to manifest Smite or a Witchfire psychic power, add 1 to the Psychic test for each model in this unit. Each time this unit manifests the Smite psychic power, add 1 to the number of mortal wounds suffered by the enemy unit for each model in this unit (to a maximum of +3 mortal wounds).</characteristic>
          </characteristics>
        </profile>
        <profile name="Warp Field (Zoanthropes)" id="689a-18d3-745f-faf4" hidden="false" page="105" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models in this unit have a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psybrood Coterie" id="23d1-9dd0-bd97-580c" hidden="false" page="105" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, then for each Detachment that includes any &lt;HIVE FLEET&gt; NEUROTHROPE units, one &lt;HIVE FLEET&gt; ZOANTHROPE unit can be included in that Detachment without taking up a Battlefield Role slot.</characteristic>
          </characteristics>
        </profile>
      </profiles>
