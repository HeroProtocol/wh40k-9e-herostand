    <profile name="Armoured Exoskeleton" id="9a20-13ca-0cea-c3e8" hidden="false" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
