    <profile name="Lashwhip Pods" id="3910-aa8e-d4d2-78ab" hidden="false" page="223" publicationId="7573-8d1b-acdf-2de8" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
