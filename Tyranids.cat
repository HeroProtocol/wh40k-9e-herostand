        <profile name="Rapacious Hunger" id="6cdb-089f-4878-cce6" hidden="false" page="104" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy model is destroyed as a result of an attack made by this model, this model regains 1 lost wound (to a maximum of 3 regained wounds per phase).</characteristic>
          </characteristics>
        </profile>
        <profile name="Grisly Spectacle (Aura)" id="15e4-9bb0-af17-03cd" hidden="false" page="104" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this model, subtract 2 from the Leadership characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Haruspex [2] (5-7 wounds)" id="6184-afdb-1991-678c" hidden="false" page="104" publicationId="7150-5917-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
