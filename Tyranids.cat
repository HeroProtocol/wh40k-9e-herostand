        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Relentless Hunger" id="7a6a-3502-654b-dd6a" hidden="false" page="61" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation fails a charge, it can make a Normal Move of up to 3&quot;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Unstoppable Swarm" id="3cb8-2f2b-3520-7bae" collective="false" hidden="false" import="true" type="upgrade">
