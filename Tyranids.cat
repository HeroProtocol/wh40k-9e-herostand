          </costs>
          <modifiers>
            <modifier field="name" type="set" value="Relic: The Ymgarl Factor"/>
          </modifiers>
          <profiles>
            <profile name="The Ymgarl Factor" id="54fa-48b9-2854-b601" hidden="false" page="70" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, select one of the following:
• Until the end of the phase, add 2 to the bearer&apos;s Strength characteristic
• Until the end of the phase, add 1 to the bearer&apos;s Attacks characteristic.
• Until the end of the phase, add 1 to the bearer&apos;s Toughness characteristic.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Reaper of Obilterax" id="acbe-148d-e7d1-85bb" collective="false" hidden="false" import="true" type="upgrade">
