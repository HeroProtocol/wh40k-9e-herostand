              <profiles>
                <profile name="Adaptive Toxins" id="307d-b2a8-6e54-d661" hidden="false" page="56" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made by a model with this adaptation against a unit (excluding VEHICLE or TITANIC units), an unmodified wound roll of 4+ is always successful.</characteristic>
