        <profile name="Blade Parry" id="2845-bdaa-5d43-68a7" hidden="false" page="91" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, the first time a saving throw made against a melee attack is failed for this model, the damage characteristic of that attack is changed to 0.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hive Commander" id="89b3-8007-b6da-f6fb" hidden="false" page="91" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly &lt;HIVE FLEET&gt; CORE unit within Synaptic Link range of this model. Until the start of your next Command phase, that unit gains the Objective Secured ability (see the Warhammer 40,000 Core Book). If that unit already had this ability, models in that unit count as one additional model when determining control of an objective marker.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Swarmlord [2] (4-6 wounds)" id="e59b-0259-50de-484c" hidden="false" page="91" publicationId="7150-5917-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
