                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, roll one D6 for each enemy unit within 3&quot; of this WARLORD: on a 2-5, that enemy unit suffers 1 mortal wound; on a 6, that enemy unit suffers D3 mortal wounds.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
