    <profile name="Scything Tail" id="cca4-c562-cf16-86fb" hidden="false" page="219" publicationId="7573-8d1b-acdf-2de8" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
