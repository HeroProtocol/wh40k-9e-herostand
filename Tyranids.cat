    <profile name="Wrecker Claws" id="98b4-26f2-f8ed-1bbd" hidden="false" page="220" publicationId="7573-8d1b-acdf-2de8" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
