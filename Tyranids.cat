              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• This model is eligible to perform Heroic Interventions as if it were a CHARACTER model.
• This model is eligible to perform a Heroic Intervention if it is within 6&quot; horizontally and 5&quot; vertically of any enemy unit, instead of 3&quot; horizontally and 5&quot; vertically. Each time this model makes a Heroic Intervention move, it can move up to 6&quot;. All other rules for Heroic Interventions still apply.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
