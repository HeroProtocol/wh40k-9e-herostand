        <profile name="Airborne" id="3fb4-2191-1690-4913" hidden="false" page="222" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You cannot declare a charge with this model, and it can only be chosen as the target of a charge if the unit making the charge can FLY. You can only fight with this model if it is within Engagement Range of any enemy units that can FLY, and this model can only make melee attacks against enemy units that can FLY. Enemy units can only make melee attacks against this model if they can FLY.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hover" id="ac8e-862b-8a1e-ab0f" hidden="false" page="222" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, this model can hover. If it does, then until your next Command phase, its Move characteristic becomes 20&quot; and it loses the Airborne, Hard to Hit and Supersonic abilities.</characteristic>
          </characteristics>
        </profile>
        <profile name="Titanic (Harridan)" id="5c8f-823d-7210-4da9" hidden="false" page="222" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to charge in a turn in which it Fell Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supersonic" id="49fd-926a-a384-1483" hidden="false" page="222" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a Normal Move, Advances or Falls Back, first pivot it on the spot up to 90° (this does not contribute to how far the model moves), then move the model straight forwards. It cannot pivot again after the initial pivot.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hard to Hit" id="c8f4-9473-2b6c-9a62" hidden="false" page="222" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against this model, subtract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
