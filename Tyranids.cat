    <profile name="Death Throes (6&quot;/D6)" id="651c-dd23-d42f-e6bf" hidden="false" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
