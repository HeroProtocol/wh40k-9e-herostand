    </profile>
    <profile name="Blistering Assault" id="ae87-8f8a-9fa1-7b93" hidden="false" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model fights, if it made a charge move or performed a Heroic Intervention this turn, then until that fight is resolved, add 1 to the Attacks characteristic of this model.</characteristic>
      </characteristics>
    </profile>
