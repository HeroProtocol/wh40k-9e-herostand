          <selectionEntries>
            <selectionEntry name="Adaptive" id="c6bb-4ed7-08fd-b6cf" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8a03-2e4f-5825-7a0f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Adaptive (Behemoth)" id="591e-ab38-4330-7049" hidden="false" page="53" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll charge rolls made for units from your army with this adaptation.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="f716-8094-f627-8657" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1e74-63b9-9478-0dc8" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Adaptive (Gorgon)" id="9e9a-f114-4131-4676" hidden="false" page="56" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation is selected to shoot or fight, you can re-roll one wound roll when resolving that unit&apos;s attacks.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="92a3-51dc-e17d-d95f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1e74-63b9-9478-0dc8" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Adaptive (Hydra)" id="870b-84ed-3d25-f112" hidden="false" page="59" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1&quot; to the Move characteristic of models with this adaptation, and each time a model with this adaptation makes a consolidation move, it can move up to an additional 3&quot; (to a maximum of 9&quot;).</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="f973-c605-fcc3-5af8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1e74-63b9-9478-0dc8" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Adaptive (Jormungandr)" id="3266-cf00-12eb-3b0f" hidden="false" page="57" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation is targeted by a weapon with the Blast rule, halve the number of models in that unit (rounding up) when determining how many attacks are made with that weapon.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="6ee0-91dd-71bf-d44f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1e74-63b9-9478-0dc8" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Adaptive (Kraken)" id="f2e4-4015-7cd5-a53c" hidden="false" page="54" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation Advances, if it is not affected by the Opportunistic Advance Stratagem or the Bounding Advance Stratagem, do not make an Advance roll. Instead, until the end of the phase, add D3+ 3&quot; to the Move characteristic of models in that unit.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="222e-9b92-1970-a607" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1e74-63b9-9478-0dc8" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Adaptive (Kronos)" id="fd65-f10b-9cb0-f49e" hidden="false" page="58" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this adaptation makes a ranged attack that targets a unit within half range, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="db16-a8c3-e63a-1f1c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1e74-63b9-9478-0dc8" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </profile>
                <profile name="Adaptive (Leviathan)" id="99bd-428c-a398-f44f" hidden="false" page="55" publicationId="7150-5917-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this adaptation is selected to shoot or fight, you can re-roll one hit roll when resolving that unit&apos;s attacks.</characteristic>
                  </characteristics>
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
