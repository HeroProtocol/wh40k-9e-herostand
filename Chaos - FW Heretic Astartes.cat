        <profile name="Chaos Mastodon 1 (16+ wounds remaining)" id="4c10-7f39-32ed-affc" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">10&quot;</characteristic>
