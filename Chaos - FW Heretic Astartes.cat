      <profiles>
        <profile name="Subterranean Assault" id="15ea-476e-bd7c-793a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, you can set up this model underground instead of placing it on the battlefield. if you do, then in the Reinforcements step of one of your Movement phases you can set this model up anywhere on the battlefield that is more than 9&quot; away from any enemy models. Any embarked models can then disembark, but must be set up on the battlefield more than 9&quot; away from any enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Transport" id="a98f-16c8-ce9c-eeb7" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport  capacity of 12 &lt;LEGION&gt; INFANTRY models. It cannot transport JUMP PACK, TERMINATOR or CULT OF DESTRUCTION models. Each POSSESSED models takes up the space of 2 models.</characteristic>
          </characteristics>
        </profile>
