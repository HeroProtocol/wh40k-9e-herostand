          <profiles>
            <profile name="Infernal bomb" id="1da8-5a43-64b6-5648" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, if the bearer has any infernal bombs remaining, it can drop one of them. Immediately after the bearer has moved, you can select one point on the battlefield the bearer moved across this phase. Roll one D6 for each unit within 6&quot; of that point, subtracting 1 if that model is a CHARACTER (excluding VEHICLE or MONSTER units): on a 4-5, that unit suffers D3 mortal wounds; on a 6, that unit suffers D6 mortal wounds. Each infernal bomb can only be dropped once per battle.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
