      <profiles>
        <profile name="Greater Brass Scorpion 1 (15+ wounds remaining)" id="5a2d-9fd9-d3db-5225" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">12&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
