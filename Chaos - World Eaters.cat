      <rules>
        <rule name="Relentless Rage" id="a5e5-0d51-ec71-2e60" hidden="false">
          <description>At the start of the Fight phase, if this unit made a charge move, was charged or performed a Heroic Intervention this turn, until the end of the phase add 1 to the Strength and Attacks characteristic of models in this unit.</description>
        </rule>
