      <profiles>
        <profile name="Mutated Beyond Reason" id="24dc-344c-67d1-f25f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform actions. The first time this unit is selected to fight in each Fight phase, roll one D3: until the end of the phase, this unit gains the relevant mutation from the table below.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 - Razor Claws" id="7106-8f2a-e92c-85f9" hidden="false" typeId="ab7d-ff53-d1ac-686c" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="5921-a76d-5c6f-f170">Change the Armour Penetration characteristic of hideous mutations models in this unit are equipped with to -4.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 - Grasping Pseudopods" id="771f-0da6-eada-f9dc" hidden="false" typeId="ab7d-ff53-d1ac-686c" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="5921-a76d-5c6f-f170">Change the Attacks characteristic of models in this unit to 3D3.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 - Toxic Haemorrhage" id="e6d1-7b0a-a4a6-0bc1" hidden="false" typeId="ab7d-ff53-d1ac-686c" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="5921-a76d-5c6f-f170">Each time a model in this unit makes an attack, you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hideous Regeneration" id="6c2d-1d92-4369-b37a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy unit shoots or fights, after it has finished making its attacks, if any model in this unit lost any wounds as a result of those attacks but was not destroyed, that model immediately regains all of its lost wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
