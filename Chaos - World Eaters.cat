        </profile>
        <profile name="Unstoppable Wrath" id="18e5-f4ae-6d82-0d97" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model can make attacks with Blast weapons against units within Engagement Range of it. Each time a ranged attack is made by this model against an enemy unit that is within Engagement Range of it, add 1 to that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
