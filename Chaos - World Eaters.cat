        <profile name="The Betrayer" id="c7a6-0383-5d5f-4484" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the Fight phase, if there are any other friendly units within 3&quot; of this model, roll one D6: on a 1, select one of those units. That unit suffers 2 mortal wounds.

In a Boarding Action, this ability only affects friendly units that are visible to this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Legendary Killer (Aura)" id="cfb2-d5a1-1973-19c8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly WORLD EATERS CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
