        <profile name="Bloodscent" id="a550-e5e0-6090-2628" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this unit is in Strategic Reserves, it can be set up as if the battle round was one higher than it currently is, regardless of any mission rules (note this means this unit can be set up on the battlefield during the first battle round).</characteristic>
