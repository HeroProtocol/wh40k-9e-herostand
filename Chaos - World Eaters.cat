        <profile name="Khorne Lord of Skulls 3 (1-7 wounds remaining)" id="b9e3-40b6-5d04-f59a" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
