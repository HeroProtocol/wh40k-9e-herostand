        </profile>
        <profile name="Servo-skull Assisted Targeting" id="14d3-c54a-fefb-7c9f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy units do not receive the benefit of cover to their saving throws for attacks made with ranged weapons by Neyam Shai Murad.</characteristic>
          </characteristics>
        </profile>
      </profiles>
