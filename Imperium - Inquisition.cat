        <profile name="Shang" id="8a13-01b1-9020-7bb3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model manifests the Smite psychic power, you can select one enemy unit within 18&quot; of and visible to this model to be affected, instead of the closest enemy unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord Inquisitor Kyria Draxus" id="6af7-7185-5380-395f" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
          <characteristics>
            <characteristic name="Cast" typeId="5afb-9914-904b-d3b3">1</characteristic>
            <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">1</characteristic>
            <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite and 1 power from the Telethesia Discipline</characteristic>
            <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Paralysis Grenades" id="fadb-b3f0-eed8-2860" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if this model made a charge move this turn, you can select one enemy unit that is within Engagement Range of this model. Until the end of that phase, the enemy unit cannot be selected to fight until all other eligible units have done so.</characteristic>
          </characteristics>
        </profile>
      </profiles>
