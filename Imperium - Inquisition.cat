        <profile name="Dread Reputation (Aura)" id="35ff-4473-d17c-92aa" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy INFANTRY unit is within 6&quot; of this model, subtract 1 from the Leadership characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Will (Aura)" id="b0b8-226f-5e9d-0b62" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When a Psychic test is taken for an enemy model within 12” of this model, subtract 1 from the total.</characteristic>
          </characteristics>
        </profile>
        <profile name="Iron Will" id="45f9-477e-4542-579c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a psychic power manifested by an enemy model targets this model, roll 2D6: if the total is greater than or equal to the Psychic test total, this model is not affected by that power (other models are still affected normally).</characteristic>
          </characteristics>
        </profile>
      </profiles>
