      </modifiers>
    </profile>
    <profile name="Refractor Field" id="f74d-e89a-68d5-81d8" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Quarry - Minoris" id="c506-0e36-0178-25bc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by a model in this unit that targets a Character unit, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
      </characteristics>
