            <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">1</characteristic>
            <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Blast. Each time an attack is made with this weapon, do not make a hit roll. Instead, roll one D6 and the attack sequence ends: if the result is greater than the highest Strength characteristic in the target unit, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
