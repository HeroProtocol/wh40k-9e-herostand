    <profile name="Brutal Judgement" id="427e-5497-9e95-038b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit makes an attack that targets a unit within half range, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
      </characteristics>
    </profile>
    <profile name="Arbites Combat Shotgun" id="3f81-91e9-a87c-ab19" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
