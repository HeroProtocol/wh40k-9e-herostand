    <selectionEntry name="[Reference] Command Protocols (All)" id="21e3-6796-16ba-cd9a" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="2e3d-9997-a569-b1ef" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="551a-4ae2-77ec-3f08" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Command Protocols" id="01b6-48da-9ea7-879a" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537" typeId="52a4-0113-5a7f-6535" typeName="Reference">
          <characteristics>
            <characteristic name="Description" typeId="8848-2b4b-4502-a86a">Command Protocols are shown in summary at the bottom of the list output.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Command Protocols - Protocol of the Undying Legions" id="266a-ba7e-94a0-4a1e" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537">
          <description>Directive 1: Each time this unit uses its Living Metal ability, each model in this unit regains 1 additional lost wound.

Directive 2: Each time you make Reanimation Protocol rolls for this unit, you can re-roll one of the dice.</description>
        </rule>
        <rule name="Command Protocols - Protocol of the Sudden Storm" id="e0c1-d4f9-da24-7a88" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537">
          <description>Directive 1: Add 1&quot; to the Move characteristic of models in this unit.

Directive 2: If this unit is performing an action, it can still make attacks with ranged weapons without that action failing.</description>
        </rule>
        <rule name="Command Protocols - Protocol of the Vengeful Stars" id="09b4-6c9e-f1e7-0713" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537">
          <description>Directive 1: Each time a model in this unit makes a ranged attack, on an unmodified wound roll of 6, improve the Armour Penetration characteristic of that attack by 1.

Directive 2: Each time a model in this unit makes a ranged attack that targets a unit within half range, the target does not receive the benefits of cover to its saving throw against that attack.</description>
        </rule>
        <rule name="Command Protocols - Protocol of the Hungry Void" id="e843-efd7-6b52-8803" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537">
          <description>Directive 1: Each time a model in this unit makes a melee attack, on an unmodified wound roll of 6, improve the Armour Penetration characteristic of that attack by 1

Directive 2: Each time a model in this unit makes a melee attack, if this unit made a charge move, was charged or performed a Heroic Intervention this turn, add 1 to that attack&apos;s Strength characteristic.</description>
        </rule>
        <rule name="Command Protocols - Protocol of the Eternal Guardian" id="4f73-35d1-1577-2b96" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537">
          <description>Directive 1: Each time an attack is made against this unit, if it did not make a Normal Move, Advance or Fall Back this battle round, this unit receives the benefit of Light cover, as described in the Warhammer 40,000 Core Book.

Directive 2: Each time an enemy unit declares a charge against this unit, if this unit is not within Engagement Range of any enemy units, it can either Hold Steady or Set to Defend. 
-If it Holds Steady, then until the end of the phase, any Overwatch attacks made by models in that unit score hits on unmodified rolls of 5+ instead of 6. 
-If it Sets to Defend, then until the end of the phase, it cannot fire Overwatch, but until the end of the next Fight phase, each time a model in that unit makes a melee attack, add 1 to that attack&apos;s hit roll.</description>
        </rule>
        <rule name="Command Protocols - Protocol of the Conquering Tyrant" id="c0eb-8cad-edff-d6b7" hidden="false" page="81" publicationId="61c6-c8c5-pubN65537">
          <description>Directive 1: Add 3&quot; to the range of this unit&apos;s aura abilities (to a maximum of 12&quot;) and increase the range of the following abilities this unit has by 3&quot; (to a maximum of 12&quot;): Lord&apos;s Will, My Will Be Done, Rites of Reanimation.

Directive 2: This unit is eligible to shoot in a turn in which it Fell Back, but if it does, then until the end of the turn, each time a model in this unit makes a ranged attack, subtract 1 from that attack&apos;s hit roll.</description>
        </rule>
      </rules>
    </selectionEntry>
