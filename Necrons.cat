        <profile name="Phylacterine Hive" id="f6da-f79a-bcba-6422" hidden="false" page="63" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, when the bearer uses its Rites of Reanimation ability, you can select one friendly &lt;DYNASTY&gt; CANOPTEK, &lt;DYNASTY&gt; DESTROYER CULT or TRIARCH PRAETORIAN unit to be affected by that ability instead of one friendly &lt;DYNASTY&gt; CORE unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Arkana: Prismatic Obfuscatron" id="2576-135c-9f2f-86da" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
