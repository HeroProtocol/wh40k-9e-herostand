        <profile name="Orikan Empowered" id="36c3-23ed-fe8d-d229" hidden="false" page="82" publicationId="61c6-c8c5-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">5&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">2+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">2+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">7</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">7</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">5</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">4</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">10</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">4+</characteristic>
          </characteristics>
        </profile>
        <profile name="Master Chronomancer" id="75e6-4854-ce12-4b76" hidden="false" page="82" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly NECRONS unit within 9&quot; of this model. Until the start of your next Command phase, you can re-roll charge rolls made for that unit and models in that unit have a 5+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Prescient Strike" id="faba-245e-aa07-bc79" hidden="false" page="82" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if this model is within Engagement Range of any enemy units, it can fight first that phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Timesplinter Mantle" id="6532-ad18-9216-5784" hidden="false" page="82" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="The Stars Are Right" id="d8af-a796-5d37-f00c" hidden="false" page="82" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this model is on the battlefield, roll one D6; if the result is less than the current battle round number, then until the end of the battle, use the Orikan Empowered profile for this model (note that any wounds it has already lost remain lost).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
