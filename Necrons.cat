      <profiles>
        <profile name="Multi-Threat Eliminator" id="5e4d-304a-b67b-3e99" hidden="false" page="93" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy model is destroyed by a ranged attack made by this model&apos;s enmitic disintegrator pistols, after this model makes the rest of its attacks, it can shoot with one of its enmitic disintegrator pistols one additional time.  These attacks cannot generate additional attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hexmark Destroyer" id="3657-784c-5e96-7679" hidden="false" page="93" publicationId="61c6-c8c5-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">8&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
