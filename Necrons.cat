        <profile name="Sentinel Construct" id="5a6e-6343-d9ec-f447" hidden="false" page="106" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy unit declares a charge against a friendly &lt;DYNASTY&gt; or DYNASTIC AGENT unit within 6&quot; of this model, unless this model is within Engagement Range of any enemy models, this model can fire Overwatch at the charging unit as if it were also a target of that charge (this is in addition to any other units that are firing Overwatch). Each time this model fires Overwatch, it makes attacks with its doomsday blaster using the high power profile.</characteristic>
          </characteristics>
        </profile>
        <profile name="Explodes (5/6/D3)" id="d152-2af0-6d97-fd88" hidden="false" page="106" publicationId="61c6-c8c5-pubN65537" typeId="1c4c-8a58-c471-95e3" typeName="Explosion">
