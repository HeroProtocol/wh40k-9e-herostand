      <profiles>
        <profile name="The Vanquisher&apos;s Mask" id="48e1-54c2-e542-1e4d" hidden="false" page="67" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, you can select one enemy unit within 3&quot; of the bearer. That unit is not eligible to fight this phase until after all eligible units from your army have done so.</characteristic>
          </characteristics>
        </profile>
      </profiles>
