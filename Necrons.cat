    <selectionEntry name="Circumstance of Awakening: The Ancients Stir" id="5f83-b710-35cd-37d5" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="e53d-354f-da05-6e55" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <profiles>
        <profile name="The Ancients Stir" id="c3f8-a1b5-be3d-5d35" hidden="false" page="55" publicationId="61c6-c8c5-pubN65537" typeId="e31c-30b0-b621-edf7" typeName="Dynastic Code">
          <characteristics>
            <characteristic name="Description" typeId="b1f8-a131-2cef-6c8b">Add 1&quot; to the Move characteristic of CANOPTEK models with this code.  Each time a CANOPTEK unit with this code makes a pile-in or consolidate move, so long as each model that moves ends its move closer to the closest enemy model, you can move each model in that unit up to 4&quot;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Dynastic Tradition: Eternal Conquerors" id="1cd7-3ee7-3fa8-4c28" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="c72d-2cee-4dac-1758" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Objective Secured" id="5e68-c807-49bd-2075" hidden="false" targetId="e07e-8dbf-0b15-7485" type="rule">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="a207-a133-6adb-25f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Eternal Conquerors" id="d9ee-8a66-940a-5718" hidden="false" page="54" publicationId="61c6-c8c5-pubN65537" typeId="e31c-30b0-b621-edf7" typeName="Dynastic Code">
          <characteristics>
            <characteristic name="Description" typeId="b1f8-a131-2cef-6c8b">Units with this code have the Objective Secured ability.  If a model in such a unit already has this ability, that model counts as one additional model when determining control of an objective marker.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="b1f8-a131-2cef-6c8b" type="set" value="Each INFANTRY model in this unit counts as one additional model when determining control of an objective marker.">
              <conditions>
                <condition childId="a207-a133-6adb-25f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="instanceOf" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Dynastic Tradition: Pitiless Hunters" id="5af7-90cd-d7ac-a62b" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="bdc8-dd9e-a834-b63e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <profiles>
        <profile name="Pitiless Hunters" id="5558-0042-5add-93e0" hidden="false" page="54" publicationId="61c6-c8c5-pubN65537" typeId="e31c-30b0-b621-edf7" typeName="Dynastic Code">
          <characteristics>
            <characteristic name="Description" typeId="b1f8-a131-2cef-6c8b">Instead of following the normal rules for Rapid Fire weapons, models with this code shooting Rapid Fire weapons make double the number of attacks if either the shooting model&apos;s target is within half the weapon&apos;s range, or if the shooting model is INFANTRY and its unit Remained Stationary in your previous Movement phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Dynastic Tradition: Superior Artisans" id="8c24-a5ea-64f7-0695" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="73e4-e9dc-4f5a-2438" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
