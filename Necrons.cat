        <profile name="Nebuloscope" id="8810-9cbf-d19a-05fa" hidden="false" page="102" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer makes a ranged attack, the target does not receive the benefits of cover against that attack.</characteristic>
          </characteristics>
