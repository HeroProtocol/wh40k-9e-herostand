          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, then for each CRYPTEK unit included in a Detachment, one CRYPTOTHRALLS unit can be included in that Detachment without taking up a Battlefield Role slot [Located in No Force Org].</characteristic>
          </characteristics>
        </profile>
        <profile name="Protectors (Aura)" id="7428-83dd-47b5-2107" hidden="false" page="95" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly CRYPTEK unit is within 3&quot; of this unit, that CRYPTEK unit can use the Look Out, Sir rule even if this unit contains fewer than 3 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Systematic Vigour" id="0306-fbc4-b7d4-dedc" hidden="false" page="95" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit is within 6&quot; of any friendly CRYPTEK units, models in this unit have a Weapon Skill and Ballistic Skill of 3+ and an Attacks characteristic of 6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
