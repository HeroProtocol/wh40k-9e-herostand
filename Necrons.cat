        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <profiles>
        <profile name="Cortical Subjugator Scarabs" id="4536-a6cd-2480-6f8d" hidden="false" page="62" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the start of the Heroic Interventions step of your opponent&apos;s Charge phase, you can select one friendly &lt;DYNASTY&gt; unit within 6&quot; of the bearer. Unless that unit is within Engagement Range of any enemy units, it can perform a Heroic Intervention as if it were a CHARACTER.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Arkana: Countertemporal Nanomines" id="8224-1d8c-a6be-84f0" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="531c-24a0-ef8f-3451" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="2880-d642-97d8-a61b" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="2"/>
        <cost name="pts" typeId="points" value="25"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e4d8-225b-cae1-1f20" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Countertemporal Nanomines" id="1b5e-d199-9e35-96e1" hidden="false" page="62" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Shooting phase, you can select one enemy unit within 18&quot; of the bearer. Until the start of your next turn, halve Advance rolls and charge rolls made for that unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Arkana: Fail-Safe Overcharger" id="dffb-1c09-0465-ee0d" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="2dd3-d41f-53d0-df4e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="1f7a-f942-6abe-8cfb" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="2"/>
        <cost name="pts" typeId="points" value="25"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e5d8-d5a6-55bf-e6fa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Fail-Safe Overcharger" id="ee67-581c-bac0-c4e6" hidden="false" page="63" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly CANOPTEK unit within 9&quot; of the bearer. Until the start of your next Command phase, add 1 to the Attacks characteristic of models in that unit. If that unit is a MONSTER or VEHICLE unit, add D3 to the Attacks characteristic of models in that unit instead of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Arkana: Hypermaterial Ablator" id="0cc6-b83b-9d59-bd38" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="9c3d-5bb4-6e81-326b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="a600-190c-279a-5357" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
        <cost name="pts" typeId="points" value="20"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <profiles>
        <profile name="Hypermaterial Ablator" id="750f-dfcc-2c65-6350" hidden="false" page="63" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly &lt;DYNASTY&gt; CORE or &lt;DYNASTY&gt; CANOPTEK unit within 9&quot; of the bearer. Until the start of your next Command phase, each time a ranged attack is made against that unit, if the attacker is more than 12&quot; away, then the unit you selected is treated as having the benefits of light cover.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Arkana: Quantum Orb" id="08f8-c573-fcd3-a9c4" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
      <constraints>
        <constraint id="4ebc-60af-99fb-402d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="56ec-e4c2-b939-b642" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
