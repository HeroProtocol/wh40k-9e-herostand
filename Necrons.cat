        <profile name="Lord of the Pyrrhian Legions (Aura)" id="7078-8291-fb47-fffe" hidden="false" page="83" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly NECRONS CORE unit is within 6&quot; of this model, add 1 to the Attacks characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mind in the Machine" id="b1f6-3ec8-4080-b086" hidden="false" page="83" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Shooting phase, you can select one enemy VEHICLE model that is visible to and within 12&quot; of this model and roll 3D6 (if the model you selected is TITANIC, roll 2D6 instead). If the result is greater than or equal to the Leadership characteristic of the selected model, you can shoot one of that model&apos;s ranged weapons as if that model was a unit from your army, using this model&apos;s Ballistic Skill characteristic instead of the target model&apos;s.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
