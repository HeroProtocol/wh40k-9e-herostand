          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, roll one D6 for each enemy unit within 6&quot; of this model; on a 4+, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
