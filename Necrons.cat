              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;DYNASTY&gt; CORE unit is within 6&quot; of this unit&apos;s Power Crucible model, add 1 to Reanimation Protocol rolls made for that unit.</characteristic>
              </characteristics>
            </profile>
            <profile name="Defence Field (Aura)" id="089e-de51-ca5e-f995" hidden="false" page="108" publicationId="b652-8bab-1453-da20" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;DYNASTY&gt; unit is within 6&quot; of this unit&apos;s Power Crucible model, models in that unit have a 5+ invulnerable save.</characteristic>
              </characteristics>
            </profile>
