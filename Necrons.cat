    <selectionEntry name="[Reference] Annihilation Protocols (All)" id="b153-21c4-653a-6962" collective="false" hidden="false" import="true" page="89" publicationId="72b8-4a28-9f58-6fa8" type="upgrade">
      <constraints>
        <constraint id="ca0a-7d35-7629-a90a" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="551a-4ae2-77ec-3f08" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Annihilation Protocols" id="d181-14a3-6e4e-ae28" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8" typeId="52a4-0113-5a7f-6535" typeName="Reference">
          <characteristics>
            <characteristic name="Description" typeId="8848-2b4b-4502-a86a">Annihilation Protocols are shown in summary at the bottom of the list output.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Annihilation Protocols - Protocol of Perfect Destruction" id="a86d-3db1-9b1e-8531" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8">
          <description>Directive 1: Add 1 to charge rolls made for this unit

Directive 2: Each time a model in this  unit piles in or consolidates, it can move up to an additional 3&quot;.</description>
        </rule>
        <rule name="Annihilation Protocols - Protocol of the Undying Gaze" id="5736-78aa-e115-f85d" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8">
          <description>Directive 1: Each time a model in this unit makes a ranged attack that targets a unit within half range, the target does not receive the benefits of cover against that attack.

Directive 2: If this unit is performing an action, it can still make attacks with ranged weapons without that action failing.</description>
        </rule>
        <rule name="Annihilation Protocols - Protocol of the Immortal Warrior" id="3a3f-1b38-ff26-11cd" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8">
          <description>Directive 1: Add 1 to the Toughness characteristic of models in this unit.

Directive 2: Improve the Save characteristic of models in this unit by 1 (models in this unit cannot have a Save characteristic better than 2+). Invulnerable saves are unaffected.</description>
        </rule>
        <rule name="Annihilation Protocols - Protocol of the Dread Strike" id="2a72-234d-7e53-f9c3" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8">
          <description>Directive 1: Each time a model in this unit makes a melee attack, an unmodified hit roll of 6 automatically wounds the target.

Directive 2: Each time a model in this unit makes a ranged attack, on an unmodified hit roll of 6, add 1 to that attack&apos;s wound roll.</description>
        </rule>
        <rule name="Annihilation Protocols - Protocol of the Killing Surge" id="b1f6-d875-721c-0965" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8">
          <description>Directive 1: Add 2&quot; to the Move characteristic of models in this unit.

Directive 2: This unit is eligible to charge in a turn in which it Fell Back.</description>
        </rule>
        <rule name="Annihilation Protocols - Protocol of the Swift Murder" id="279d-5527-47fb-33c9" hidden="false" page="89" publicationId="72b8-4a28-9f58-6fa8">
          <description>Directive 1: Each time an attack is made against this unit, if it did not Remain Stationary this battle round, this unit receives the benefits of Light Cover, as described in the Warhammer 40,000 Core Book.

Directive 2: This unit is eligible to perform Heroic Interventions as if it were a CHARACTER unit.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Warlord Trait (Annihilation): Furious Destructor" id="1f4d-b270-b026-799a" collective="false" hidden="false" import="true" publicationId="61c6-c8c5-pubN65537" type="upgrade">
