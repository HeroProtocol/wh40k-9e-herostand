        <profile name="Powers of the C&apos;tan (Nightbringer)" id="66d3-adf2-663a-54b8" hidden="false" page="98" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model knows the Gaze of Death C&apos;tan Power and one other C&apos;tan Power from the Powers of the C&apos;tan. At the end of your Movement phase, if this model did not Advance or Fall Back that phase, it can use two of the C&apos;tan Powers it knows. It cannot use the same C&apos;tan Power more than once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Drain Life" id="ba25-fb71-1496-2e38" hidden="false" page="98" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a melee attack that is allocated to an enemy model, that enemy model cannot use any rules to ignore the wounds it loses.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
