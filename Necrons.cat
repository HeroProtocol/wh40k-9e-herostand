        <profile name="Spear of the Void Dragon (Shooting)" id="bbea-555f-0519-a67c" hidden="false" page="113" publicationId="61c6-c8c5-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
