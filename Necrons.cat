      <profiles>
        <profile name="Wraith Form" id="ac1a-5b53-7f43-3288" hidden="false" page="103" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models in this unit have a 4+ invulnerable save. In addition, each time this unit makes a Normal Move, Advances, Falls Back or it makes a charge move, until that move is finished, models in this unit can move horizontally through models and terrain features (they cannot finish a move on top of another model, or its base).</characteristic>
          </characteristics>
        </profile>
        <profile name="Slinking Strike" id="31a9-fc09-4a82-34bc" hidden="false" page="103" publicationId="61c6-c8c5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit is eligible to shoot and declare a charge with in a turn in which it Fell Back</characteristic>
          </characteristics>
        </profile>
