          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll Morale tests for a unit whilst it contains a model with a cult vox-caster.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
