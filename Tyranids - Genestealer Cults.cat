        <profile name="Spiritual Leader (Aura)" id="d0a0-befc-cec1-64ce" hidden="false" page="91" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In the Psychic phase, while a friendly &lt;CULT&gt; INFANTRY or &lt;CULT&gt; BIKER unit is within 6&quot; of this model, each time a model in that unit would lose a wound as a result of a mortal wound, roll one D6: on a 5+ , that would is not lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Stratagem: The Cult&apos;s Psyche" id="0df9-5ef6-5fa7-c433" collective="false" hidden="true" import="true" type="upgrade">
          <constraints>
