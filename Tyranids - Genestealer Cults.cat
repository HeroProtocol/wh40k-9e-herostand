      <profiles>
        <profile name="Scrambler Array" id="255a-bdc7-0118-09c6" hidden="false" page="98" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy units that are set up on the battlefield as Reinforcements cannot be set up within 12&quot; of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Proclamation Hailer" id="d540-4a32-65d2-84e8" hidden="false" page="98" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly &lt;CULT&gt; CORE unit within 12&quot; of this model. Until the start of your next Command phase:
• Each time that unit performs an action, it can shoot without that action failing.
• Each time a Combat Attrition test is taken for that unit, it is automatically passed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Clamavus" id="5a1d-9efd-4272-ef05" hidden="false" page="98" publicationId="83b2-e602-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">3</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">3</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">4</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">3</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">8</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Voice of New Truths" id="c3fd-09e6-fd28-4023" hidden="false" page="98" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Morale phase, select one enemy unit within 12&quot; of this model and roll 3D6: if the result is greater than that enemy unit&apos;s Leadership characteristic, select one of the following:
• Until the start of your next Morale phase, that unit cannot perform actions (if that unit is currently performing an action, it immediately fails).
• Until the start of your next Morale phase, that unit loses the Objective Secured ability.

Each unit can only be selected for this ability once per phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
