        <profile name="Priority Target" id="409b-9829-6d37-ff4f" hidden="false" page="92" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly &lt;CULT&gt; CORE CROSSFIRE unit within 9&quot; of this model, then select one enemy unit within 36&quot; of and visible to this model. Until the end of the turn, each time this model or a model in that friendly unit makes a ranged attack against that enemy unit, that enemy unit is treated as being Exposed for that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master Outrider" id="8050-0da2-0443-4796" hidden="false" page="92" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is within 6&quot; of a friendly &lt;CULT&gt; ATALAN JACKALS or &lt;CULT&gt; VEHICLE unit, enemy models cannot target this model with ranged weapons unless it is the closest eligible target. Each time an attack is made against this model, subtract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Jackal" id="bf86-b665-07d8-1507" hidden="false" page="92" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to shoot and declare a charge in a turn in which it Fell Back.</characteristic>
          </characteristics>
        </profile>
      </profiles>
