      <profiles>
        <profile name="Savage Amalgam" id="9006-78a9-27d6-1c0b" hidden="false" page="96" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit is destroyed by a melee attack, if this model has not fought this phase, do not remove it from play. The destroyed model can fight after the attacking model&apos;s unit has finished making attacks. After doing so, any other rules that affect this model &apos;when it is destroyed&apos; are triggered (if any), and then the model is removed from play.</characteristic>
          </characteristics>
        </profile>
      </profiles>
