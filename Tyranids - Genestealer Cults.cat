            <constraint id="664d-56db-c389-c45a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Chemical Vials" id="ccbc-9434-5980-b8a0" hidden="false" targetId="8b6b-144d-9706-4675" type="profile"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Cult Creed" id="1f06-b5e7-f263-d979" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="1247-ecd9-5cc4-49c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="max" value="1"/>
        <constraint id="5189-1055-0363-f8e3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="force" shared="true" type="min" value="1"/>
      </constraints>
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Cult Creed" id="c277-73ae-caa8-2d98" hidden="false" page="54" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All GENESTEALER CULTS units with this ability, and all models in them, gain a Cult Creed provided every unit in their Detachment that belongs to a cult belongs to the same cult. The Cult Creed gain depends on which cult they belong to, as shown on the following pages.

If your cult does not have an associated Cult Creed, it is known as a Myriad Cult and you must instead create your own Cult Creed for them, as described on pages 62-63; this allows you to customise the rules for your Myriad Cult. In either case, write down all your Detachments&apos; Cult Creeds on your army roster.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Splinter Cult" id="345a-3423-f117-de94" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3392-6748-5240-ad02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Splinter Cult" id="5c61-1e40-1633-b661" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Select one of the following cults: Cult of the Four-armed Emperor, the Hivecult, the Bladed Cog, the Rusted Claw, the Pauper Princes, the Twisted Helix.
• Use the Cult Creed of the cult you selected, as listed on pages 56-61.
• If a CHARACTER model with this Myriad Cult Creed gains a Warlord Trait, they can have the Cult Warlord Trait associated with the cult you selected, instead of of a Warlord Trait from page 70. If a CHARACTER has such a Warlord Trait, replace all instances of the &lt;CULT&gt; keyword on that Warlord Trait (e.g. TWISTED HELIX), if any, with the name of the Myriad Cult that this CHARACTER is from.
• Unless the only units with this Myriad Cult are part of an Auxiliary Super, Super-heavy Auxiliary and/or Fortification Network Detachment, you will gain access to the Cult Stratagem associated with the cult you selected. When using such a Stratagem, replace all instances of the &lt;CULT&gt; keyword on that Stratagem (e.g. TWISTED HELIX), if any, with the Myriad Cult that the units with this Myriad Cult Creed have.
• Unless the only units with this Myriad Cult are part of an Auxiliary Super, Super-heavy Auxiliary and/or Fortification Network Detachment, &lt;CULT&gt; PSYKER models with this Myriad Cult Creed know the psychic power associated with the cult you selected in addition to any other psychic powers they know. When using that psychic power, replace all instances of the &lt;CULT&gt; keyword on that psychic power (e.g. TWISTED HELIX), if any, with the Myriad Cult that the units with this Myriad Cult Creed have.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Cult Creeds" id="d2cd-52d9-69a7-7cce" collective="false" defaultSelectionEntryId="3d56-645e-1713-66a6" hidden="false" import="true">
          <constraints>
            <constraint id="4635-e08c-4442-ede0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="0952-5eb0-7097-dd3d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Cult of the Four-Armed Emperor" id="3b53-1eb8-07ea-90ff" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Subterranean Ambushers" id="1a4c-1614-ca8e-4358" hidden="false" page="56" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• You can re-roll charge rolls made for unis with this creed.
• Each time a ranged attack is made against a unit with this creed, if the attacker is more than 12&quot; away, then the unit with this creed is treated as having the benefits of Light Cover against that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Pauper Princes" id="343d-6602-d287-273c" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Devoted Zealots" id="9be5-af11-41f2-278e" hidden="false" page="60" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• Each time a model with this creed makes a melee attack, if that model&apos;s unit made a charge move, was charged or performed a Heroic Intervention this turn, add 1 to that attack&apos;s hit roll.
• Each time a Combat Attrition test is taken for a unit with this creed, you can ignore any or all modifiers.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Hivecult" id="edc9-1e67-5e26-f5b8" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Disciplined Militants" id="400a-12b9-bd1c-ab4f" hidden="false" page="57" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• Units with this creed are eligible to shoot in a turn in which they Fell Back, but if they do so, then until the end of that turn, each time a model in that unit makes a ranged attack, subtract 1 from that attack&apos;s hit roll.
• Units with this creed can perform action in a turn in which they Fell Back or Advanced. While a unit with this creed is performing an action, that unit can shoot without that action failing.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Bladed Cog" id="38a5-fe16-ba9a-7e40" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Cyborgised Hybrids" id="1720-3c97-54ce-fe51" hidden="false" page="58" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• Models with this creed have a 6+ invulnerable save.
• Each time a unit with this creed is selected to shoot or fight, you can re-roll one wound roll when resolving that unit&apos;s attacks.
• Add 3&quot; to the Range characteristic of ranged weapons that models with this creed are equipped with (excluding Grenades and cache of demolition charges).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Rusted Claw" id="b1c4-6f3e-8830-d783" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Nomadic Survivalists" id="4036-4164-ef52-ddbe" hidden="false" page="59" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• Each time an attack is allocated to a model with this creed, if that attack has an Armour Penetration characteristic of -1 or -2, the Armour Penetration characteristic of that attack is worsened by 1.
• Each time a unit with this creed makes a Normal Move or Advances in your Movement phase, until the end of your Shooting phase, it counts as having Remained Stationary.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="The Twisted Helix" id="674f-970a-a898-0d21" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Experimental Subjects" id="c128-feef-a043-6d84" hidden="false" page="61" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">• Add 1 to the Strength characteristic of models with this creed.
• Add 1&quot; to the Move characteristic of models with this creed.
• Each time an attack is made against a unit with this creed, an unmodified wound roll of 1-2 automatically fails, irrespective of any abilities that the weapon or attacker may have.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="None (Mixed Detachment)" id="3d56-645e-1713-66a6" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="345a-3423-f117-de94" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1f06-b5e7-f263-d979" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
            </selectionEntry>
            <selectionEntry name="Myriad Cult" id="1122-4119-2065-e6ba" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="345a-3423-f117-de94" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="1f06-b5e7-f263-d979" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Myriad Cults" id="15fc-594e-026b-cad7" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your chose cult does not have an associated Cult Creed on pages 56-61, you must instead create their Cult Creed by selecting Myriad Cult Creeds from the list here. Each Myriad Cult Creed has a value displayed with it; when selecting your Myriad Cult Creeds, their combined value cannot exceed 4. When you select a Myriad Cult Creed, replace all instanced of the &lt;CULT&gt; keyword (if any) with the name of your Myriad Cult.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntryGroups>
                <selectionEntryGroup name="Creeds" id="bd2c-83d8-2272-6a33" collective="false" hidden="false" import="true">
                  <constraints>
                    <constraint id="1b3c-ebee-9a89-f4c2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="4"/>
                  </constraints>
                  <modifierGroups>
                    <modifierGroup>
                      <modifiers>
                        <modifier field="1b3c-ebee-9a89-f4c2" type="decrement" value="2"/>
                      </modifiers>
                      <repeats>
                        <repeat childId="7ecb-3dd1-d1a7-c02f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="76c3-557e-3668-a8aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="43bc-e6bf-f64b-83e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                      </repeats>
                    </modifierGroup>
                    <modifierGroup>
                      <modifiers>
                        <modifier field="1b3c-ebee-9a89-f4c2" type="decrement" value="1"/>
                      </modifiers>
                      <repeats>
                        <repeat childId="f942-c21e-0a28-3274" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="cd1d-dd7c-be0a-f018" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="c6b4-2781-39bc-409f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="d9a6-07bf-b870-0899" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="053e-762e-e825-4a79" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                      </repeats>
                    </modifierGroup>
                  </modifierGroups>
                  <selectionEntries>
                    <selectionEntry name="Hunter&apos;s Instincts (3)" id="7ecb-3dd1-d1a7-c02f" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="c819-f26e-aa7c-27fe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Hunter&apos;s Instincts" id="2ff1-fe20-4ac2-7199" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll charge rolls made for units with this creed.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Impassioned (3)" id="76c3-557e-3668-a8aa" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="a9f8-1204-bba2-5561" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Impassioned" id="2d26-5e2f-4908-3f2d" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this creed makes a melee attack, if that model&apos;s unit made a charge move, was charged, or performed a Heroic Intervention this turn, add 1 to that attack&apos;s hit roll.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Symbiotic Broodmind (3)" id="43bc-e6bf-f64b-83e6" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="2056-8969-fef5-1d80" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Symbiotic Broodmind" id="e710-e737-8d3b-ea1c" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit with this creed is eligible to shoot in a turn in which it Fell Back. If it does so, then until the end of the turn, each time a model that unit makes a ranged attack, subtract 1 from that attack&apos;s hit roll.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Deep Supplies (2)" id="053e-762e-e825-4a79" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="4f8f-60d7-562e-bd56" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Deep Supplies" id="7f27-a89f-a1df-d2bd" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this creed is seletced to shoot or fight, you can re-roll one wound roll when resolving that unit&apos;s attacks.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Agile Guerrillas (2)" id="c6b4-2781-39bc-409f" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="e420-68cf-459a-e6cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <modifiers>
                        <modifier field="e420-68cf-459a-e6cd" type="set" value="0">
                          <conditions>
                            <condition childId="cd1d-dd7c-be0a-f018" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="atLeast" value="1"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Agile Guerrillas" id="d288-f5f7-ba38-cb92" hidden="false" page="62" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this creed makes a Normal Move or Advnaces in your Movement phase, in your following Shooting phase, that unit counts as having Remained Stationary. If you select this creed, you cannot select the Martial creed opposite.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Martial (2)" id="cd1d-dd7c-be0a-f018" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="ddff-860e-78f1-b4d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <modifiers>
                        <modifier field="ddff-860e-78f1-b4d3" type="set" value="0">
                          <conditions>
                            <condition childId="c6b4-2781-39bc-409f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="atLeast" value="1"/>
                          </conditions>
                        </modifier>
                      </modifiers>
                      <profiles>
                        <profile name="Martial" id="9f82-8ff3-6104-0e4a" hidden="false" page="63" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a CROSSFIRE INFANTRY model with this creed makes a ranged attack, unless that model&apos;s unit has moved this turn, the target is treated as having a crossfire marker (pg 89) for that attack. If you select this creed, you cannot select the Agile Guerrillas creed opposite.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Thralls of the Patriarch (2)" id="f942-c21e-0a28-3274" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="88f2-10dc-8a4c-a24a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Thralls of the Patriarch" id="8f7b-5f74-5955-7ad4" hidden="false" page="63" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Combat Attrition test is take for a unit with this creed, ignore any or all modifiers.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Toxin Agents (2)" id="d9a6-07bf-b870-0899" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="56e8-a7d3-b89c-70dc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
