                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Psychic test is taken for a unit with this creed, you can re-roll any or all dice rolls of 1-2.</characteristic>
                          </characteristics>
