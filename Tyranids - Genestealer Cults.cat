    <profile name="Toxin Injector Claw" id="71f5-662e-5cf3-e5da" hidden="false" page="109" publicationId="83b2-e602-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
