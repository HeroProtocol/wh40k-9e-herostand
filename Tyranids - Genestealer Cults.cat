          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Quicksilver Strike" id="7245-72eb-cae1-561c" hidden="false" page="99" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if this model is within Engagement range of any enemy units, it can fight first that phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Locus" id="b70e-98d4-77fe-0857" hidden="false" page="99" publicationId="83b2-e602-pubN65537" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">6&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">2+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">3+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">4</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">4</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">5</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">8</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Bodyguard" id="fb46-b5b5-7ef5-e33c" hidden="false" page="1" publicationId="db16-1a92-fdd3-95a9" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During deployment, select one &lt;CULT&gt; CHARACTER model from your army (excluding a LOCUS model) to be this model&apos;s ward.
• While this model is within 3&quot; of its ward, that ward can use the Look Out, Sir rule even if this unit contains fewer than 3 models.
• While this model is a viable target for melee attacks made by an enemy model, that enemy model cannot target this model&apos;s ward with melee attacks.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sudden Assault" id="f946-809c-7caf-ec93" hidden="false" page="99" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model is eligible to perform a Heroic Intervention if it is within 6&quot; horizontally and 5&quot; vertically of any enemy unit, instead of 3&quot; horizontally and 5&quot; vertically. Each time this model makes a Heroic Intervention move, provided it ends that move either closer to the closest enemy model or within Engagement Range of an enemy CHARACTER unit, it can move up to 6&quot;. All other rules for Heroic Interventions still apply.</characteristic>
          </characteristics>
        </profile>
      </profiles>
