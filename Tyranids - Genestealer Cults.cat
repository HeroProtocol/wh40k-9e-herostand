                      <profiles>
                        <profile name="Alien Fury" id="0e9a-3f03-7fe3-2e67" hidden="false" page="63" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this creed piles in or consolidates, models in that unit can move an additional 1&quot;.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
