                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer gains the Crossfire abilitiy (pg 89) and the CROSSFIRE keyword. This Relic replaces an autopistol.</characteristic>
              </characteristics>
            </profile>
            <profile name="Oppressor&apos;s Bane" id="f89b-5f63-7442-0cf4" hidden="false" page="72" publicationId="83b2-e602-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">15&quot;</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistol 3</characteristic>
                <characteristic name="S" typeId="59b1-319e-ec13-d466">4</characteristic>
                <characteristic name="AP" typeId="75aa-a838-b675-6484">-2</characteristic>
                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made with this weapon, the target is treated as having a crossfire marker and as being Exposed (pg 89) for that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dagger of Swift Sacrifice" id="08e6-f222-d72b-b49d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
