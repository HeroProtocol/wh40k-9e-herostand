          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with a dozer blade charges in the Charge phase, add 1 to hit rolls for it until the end of the ensuing Fight phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Track Guards" id="fa27-6adc-7676-a948" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
