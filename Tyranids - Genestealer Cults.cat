      </costs>
      <profiles>
        <profile name="Track Guards" id="02bd-a0e0-77c2-116c" hidden="false" page="103" publicationId="83b2-e602-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with track guards always counts as having its starting number of Wounds when determining its Move characteristic (i.e. its Move characteristic does not decrease as it suffers wounds).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Cult Vox-caster" id="fa0a-703b-8739-c4ee" collective="false" hidden="false" import="true" type="upgrade">
