        <profile name="Transport" id="6fcc-dd07-ecf8-1bbe" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">The Sokar Pattern Stormbird can transport 50 &lt;CHAPTER&gt; INFANTRY or &lt;CHAPTER&gt; BIKER models. Each JUMP PACK, WULFEN, Mk X GRAVIS or TERMINATOR model takes the space of 2 models (a PRIMARIS JUMP PACK model takes up the space of 3 models instead). Each CENTURION or BIKER takes the space of 3 models (a PRIMARIS BIKER takes up the space of 4 models instead). It can transport 1 &lt;CHAPTER&gt; RHINO model, which (inculding any models embarked within it) take up the space of 25 models</characteristic>
          </characteristics>
        </profile>
        <profile name="Sokar-Pattern Stormbird [1] (21+ wounds remaining)" id="60f2-3a0a-2559-2a12" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
