    <selectionEntryGroup name="Obscuration Discipline" id="c3ab-8b2c-2039-6f5a" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="1) Shrouding" id="b756-66b8-5b51-b9b1" collective="false" hidden="false" import="true" type="upgrade">
