            <profile name="Whirlwind of Rage" id="150b-645b-0343-63a0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this tactic makes a melee attack, if that model&apos;s unit made a charge move, was charged or performed a Heroic Intervention this turn, an unmodified hit roll of 6 scores an additional hit.

You cannot select this tactic if you have already selected the Duellists tactic.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Duellists" id="32c5-8ffa-5000-f855" collective="false" hidden="false" import="true" type="upgrade">
