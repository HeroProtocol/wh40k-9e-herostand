                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Quake Bolts" id="17fb-6a10-ec0f-bcd5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When you give a model this Relic, select one bolt weapon that model is equipped with. When that model is chosen to shoot with, you can choose for that weapon to fire a quake bolt. If you do, you can only make one attack with that weapon, but if a hit is scored, the target unit is felled until the end of the turn in addition to any normal damage. Each time a melee attack is made against a unit that is felled, add 1 to that attack&apos;s hit roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
