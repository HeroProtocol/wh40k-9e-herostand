                    <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
                    <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">When the bearer fights, it makes 1 additional attack with this weapon. When resolving an attack made with this weapon against a VEHICLE unit, this weapon has a Strength characteristic of x2 for that attack</characteristic>
                  </characteristics>
                </profile>
              </profiles>
