    <selectionEntry name="Witchseeker Bolts" id="b51d-f416-0be9-9aae" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="52c5-c3f8-df1a-56e6" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
