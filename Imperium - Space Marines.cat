                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When a model with this Relic fights, it can make 1 additional attack using the close combat weapon profile (see the Warhammer 40,000 rulebook). When resolving that attack, if a hit is scored the target suffers 1 mortal wound and the attack sequence ends.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
