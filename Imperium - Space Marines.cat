          <profiles>
            <profile name="Storm of Fire" id="0b2c-b1a7-4c82-cfcd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;CHAPTER&gt; CORE is within 6&quot; of this WARLORD, each time a model in that unit makes a ranged attack, on an unmodified wound roll of 6, improve the armour penetration characteristic of that attack by 1</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Imperium&apos;s Sword" id="53e3-9d00-87e4-f41c" collective="false" hidden="false" import="true" type="upgrade">
