              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase you can select one friendly &lt;CHAPTER&gt; PHOBOS unit within 6&quot; of this WARLORD. Until the start of your next Command phase, each time a model in that unit makes a ranged attack, add 1 to that attacks hit roll</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="6. Master Marksman" id="95be-64c0-009c-84ac" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="940c-5301-3af6-a187" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="53bc-ffed-fcb6-dd61" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
