      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">-</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">-</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">4+</characteristic>
