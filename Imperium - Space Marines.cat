              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unless this WARLORD is the closest eligible target, enemy models cannot target it with ranged attacks</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="5. Target Priority" id="b045-d4e1-0029-84c2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a4f5-e5be-42e1-cbf5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="10a0-eee5-3921-7df2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
