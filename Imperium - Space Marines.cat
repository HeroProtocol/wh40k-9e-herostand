        <profile name="Lion El&apos;Jonson" id="60ca-6459-98e5-5554" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">8&quot;</characteristic>
