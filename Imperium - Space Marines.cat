              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Damage characteristic of ranged weapons this Warlord is equipped with. (Excluding Grenades and Relics)</characteristic>
