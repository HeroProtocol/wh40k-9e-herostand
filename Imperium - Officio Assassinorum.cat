          </characteristics>
        </profile>
        <profile name="Etherium" id="08a0-a7cf-9df0-61f0" hidden="false" publicationId="f731-6aa6-pubN66377" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack that targets this model, the attacking model is treated as having a Weapon Skill and Ballistic Skill characteristic of 6+.</characteristic>
          </characteristics>
        </profile>
        <profile name="Life Drain" id="56b8-7376-7809-cce9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made with a melee weapon by this model, saving throws and Daemonic saving throws cannot be made unless it is an invulnerable saving throw.</characteristic>
          </characteristics>
        </profile>
        <profile name="Abomination" id="188f-a12e-5ec8-001c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model can never be targeted or affected by psychic powers in any way. PSYKER units that are within 18&quot; of any CULEXUS ASSASSINS must subtract 2 from Psychic tests and Deny the Witch tests they take.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Assassin" id="a9b3-8751-d45c-5aa1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you select a target for a ranged weapon this model is making an attack with, you can ignore the Look Out, Sir rule if you select a Psyker Character unit. In addition, this model can shoot with its psyk-out grenades in the same phase that it shoots with its animus speculum.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
