            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">3&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">If manifested, pick a friendly HERETIC ASTARTES unit within 3&quot; of the psyker. That unit can immediately move as if it were its Movement phase. You cannot use Warptime on a unit more than once in each Psychic phase.</characteristic>
          </characteristics>
