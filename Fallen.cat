            <profile name="Eternal Vendetta" id="af0a-86bf-d6c1-eaa9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll failed wound rolls for attacks made by your Warlord in the Fight phase against targets with the ADEPTUS ASTARTES keyword.</characteristic>
              </characteristics>
            </profile>
