      <profiles>
        <profile name="Gift of Chaos" id="d56e-120c-a1fa-1501" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">6&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">If manifested, select an enemy unit that is within 6&quot; of the psyker and visible to him and roll a D6. If the result is greater than the enemy&apos;s Toughness, it suffers D3+3 mortal wounds. If a CHARACTER is slain by this power, you can add a Chaos Spawn to your army and set it up within 1&quot; of the character before it is removed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Diabolic Strength" id="2866-73df-a356-1f74" collective="false" hidden="false" import="true" type="upgrade">
