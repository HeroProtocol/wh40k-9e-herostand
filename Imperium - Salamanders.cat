        </profile>
        <profile name="Arridian Drakehide Cloak" id="f71f-46b0-eae8-1060" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack against this model, reduce the Damage characteristic of the weapon used by 1, to a minimum of 1, for that attack.</characteristic>
          </characteristics>
        </profile>
