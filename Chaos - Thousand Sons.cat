        <profile name="Oraculae Brazier" id="dbe9-4a41-9aab-50bb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one CULT OF PROPHECY CORE or CULT OF PROPHECY CHARACTER unit within 6&quot; of the bearer. Until the start of your next Command phase, each time that unit is selected to shoot or fight, you can re-roll one hit roll, one wound roll and one damage roll when resolving that unit&apos;s attacks.</characteristic>
          </characteristics>
        </profile>
