              <characteristics>
                <characteristic name="Ability" typeId="6e48-f837-972a-1a87">If this pact is successful, select one enemy unit within 30&quot; of and visible to this INFERNAL MASTER.
- If that unit contains 6 or more models, it suffers 1 mortal wound.
- Until the start of your next Command phase, subtract 2 from Advance and charge rolls made for that unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
