              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when this WARLORD is selected as the target of a charge, before the charge roll is made and after firing any Overwatch, it can make a Normal Move up to 6&quot;.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
