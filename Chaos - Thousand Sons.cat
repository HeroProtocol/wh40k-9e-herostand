      <profiles>
        <profile name="Primarch of the Thousand Sons (Aura)" id="c1d3-d9b0-46f8-99c1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly THOUSAND SONS CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Crown of the Crimson King" id="57e3-3d57-646c-c742" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. In addition, thism odel never suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
        <profile name="Magnus the Red" id="e66f-2ac5-f42c-c62f" hidden="false" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
          <characteristics>
            <characteristic name="Cast" typeId="5afb-9914-904b-d3b3">3</characteristic>
            <characteristic name="Deny" typeId="b5ac-9c20-5d5a-6f9b">3</characteristic>
            <characteristic name="Powers Known" typeId="69d7-b45e-00a2-7e46">Smite and three powers from the Discipline of Change and/or Discipline of Vengeance.</characteristic>
            <characteristic name="Other" typeId="c2e2-f115-0003-5d7b"/>
          </characteristics>
        </profile>
        <profile name="Gaze of Magnus" id="2916-8e48-0255-7847" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model manifests the Smite psychic power, inflict D6 mortal wounds instead of D3, or 3D3 mortal wounds instead of D6 if the result of the Psychic test was 11 or more.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unearthly Power" id="2792-3d17-5243-6607" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll Psychic tests taken for this model. Each time a Psychic test or deny the Witch test is taken for this model, add 1 to the result (if this model has 10 or more wounds remaining, dd 2 to the result instead).</characteristic>
          </characteristics>
        </profile>
        <profile name="Daemon Primarch" id="3889-d409-e495-de19" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, this model must be your army&apos;s WARLORD. If more than one model in your army has a rule to this effect, then one of those models must be your army&apos;s WARLORD.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of the Planet of the Sorcerers" id="3df1-1b84-1eae-ee67" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly THOUSAND SONS CORE or THOUSAND SONS CHARACTER unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll.</characteristic>
          </characteristics>
        </profile>
