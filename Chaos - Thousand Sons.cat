      <profiles>
        <profile name="Fearsome (Aura)" id="2bf3-beab-08b9-135e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this unit, subtract 1 from the Leadership characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 - Razor Claws" id="a782-76c8-c8d9-d530" hidden="false" typeId="0df0-4184-4497-92fd" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="44eb-303c-2970-925a">Until the end of the phase, the Armour Penetration characteristic of hideous mutations models in this unit are equipped with is changed to -4.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 - Grasping Pseudopods" id="cef1-b7a6-2e08-a77e" hidden="false" typeId="0df0-4184-4497-92fd" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="44eb-303c-2970-925a">Until the end of the phase, models in this unit have an Attacks characteristic of 3D3.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 - Toxic Haemorrhage" id="ec9c-d265-8cb8-1218" hidden="false" typeId="0df0-4184-4497-92fd" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="44eb-303c-2970-925a">Until the end of the phase, each time a model in this unit makes an attack, you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mutated Beyond Reason" id="e614-b920-0fdf-0f32" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The first time this unit is selected to fight in each Fight phase, roll one D3 and consult the table below.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fated Mutation" id="8422-8307-fbe0-028e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit is selected to fight, you do not need to roll to determine which Mutated Beyond Reason ability applies. Simply pick the  result you wish to apply for the duration of that fight.</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
