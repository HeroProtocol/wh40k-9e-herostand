        <profile name="Mutalith Vortex Beast 1 (8+ wounds remaining)" id="b29e-3ce7-6588-7974" hidden="false" typeId="0cb4-9954-9937-7c3a" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="9442-5c32-769c-ab54">10&quot;</characteristic>
            <characteristic name="WS" typeId="4643-adf8-953d-cf00">3+</characteristic>
