      <profiles>
        <profile name="Arcane Focus" id="cc1a-64d5-4341-4466" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is a Cabal of Sorcerers, the bearer has the following ability: &apos;Arcane Focus: At the start of your Psychic phase, select one friendly CULT OF MAGIC PSYKER unit within 6&quot; of the bearer. Until the end of the phase, each time you would use a Cabbalistic Ritual on this unit, it costs one fewer Cabal points.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Athenaean Scrolls" id="9b79-c33f-e501-04f1" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="8be3-ed17-1aee-67d8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="040d-9bcd-4079-d01b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
