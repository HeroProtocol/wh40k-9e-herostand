          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack, if it has 7 or fewer wounds remaining, re-roll a wound roll of 1.</characteristic>
          </characteristics>
