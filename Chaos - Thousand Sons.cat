          <profiles>
            <profile name="Baleful Devolution" id="df91-0562-7616-2a90" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">8</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Witchfire: If manifested, select one enemy unit within 18&quot; of and visible to this PSYKER that contains 6 or more models. Roll a number of D6 equal to the result of the Psychic test: for each roll of 6, that enemy unit suffers D3 mortal wounds.</characteristic>
              </characteristics>
