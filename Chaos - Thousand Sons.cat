            <profile name="Immaterial Echo" id="4a0a-32d6-9c72-a768" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Psychic phase, if this WARLORD manifests a psychic power with a Psychic test result of 9+, this WARLORD can attempt to manifest one additional psychic power that phase. When attempting to manifest that additional psychic power, if the Psychic test is passed, it cannot be denied. Only one additional psychic power can be manifested as a result of this Warlord Trait per phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
