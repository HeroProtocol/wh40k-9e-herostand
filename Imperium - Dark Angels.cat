      <profiles>
        <profile name="2. Fury if the Lion (Aura)" id="c791-4173-3cf2-af84" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DARK ANGELS unit is within 6&quot; of this WARLORD, if this WARLORD has made a charge move, was charged or performed a Heroic Intervention this turn, add 1 to the Strength Characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
