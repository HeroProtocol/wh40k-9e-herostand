        </profile>
        <profile name="Master Interromancer" id="e35e-7362-7f6f-5bbe" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model attempts to manifest a psychic power from the Interromancy discipline, add 1 to the Psychic test.</characteristic>
