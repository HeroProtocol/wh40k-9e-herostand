        <profile name="Chapter Master" id="040e-6829-e326-5951" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly DARK ANGELS CORE or DARK ANGELS CHARACTER unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Supreme Tactician" id="b8e1-60be-0451-9951" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged and this model is your WARLORD, you receive an additional 2 Command points.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lion Helm (Aura)" id="aab6-05e2-36be-614a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DARK ANGELS INFANTRY or DARK ANGELS BIKER unit is within 6&quot; of this model, models in that unit have a 4+ invulnerable save against ranged attacks</characteristic>
          </characteristics>
        </profile>
      </profiles>
