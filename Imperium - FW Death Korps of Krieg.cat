        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">D3</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each demolition charge can only be used once per battle.</characteristic>
      </characteristics>
    </profile>
    <profile name="Twin Heavy Stubber" id="5a02-5165-adc7-f9a8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
