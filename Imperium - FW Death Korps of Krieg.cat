  <sharedProfiles>
    <profile name="Implacable Officer (Aura)" id="f884-552c-9917-3f45" hidden="false" publicationId="b652-8bab-1453-da20" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Morale phase, select one friendly KRIEG unit within 6&quot; of this model. Until the end of the phase, that unit automatically passes Morale tests.</characteristic>
      </characteristics>
    </profile>
