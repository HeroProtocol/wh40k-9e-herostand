          <profiles>
            <profile name="Corrosive Filth" id="86c3-5ed3-0055-a1f3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made with this weapon against a VEHICLE unit, add 1 to the Damage characteristic of that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Deadly Pathogens" id="eceb-70be-f892-b24b" hidden="false">
              <description>Each time you give a model a Deadly Pathogen, select one plague weapon that model is equipped with to upgrade (this cannot be a Grenade weapon or a Relic). In addition to the effects listed for that Deadly Pathogen, add1 to the Strength characteristic of that plague weapon. The Power rating of that model&apos;s unit is increased by 1.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Viscous Death" id="9c1e-ddeb-af41-7f80" collective="false" hidden="false" import="true" type="upgrade">
