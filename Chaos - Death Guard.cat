      <profiles>
        <profile name="Fearsome (Aura)" id="36de-6b5b-d1df-80a6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy unit is within 6&quot; of this unit, subtract 1 from the Leadership characteristic of models in that enemy unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mutated Beyond Reason" id="3937-7401-45fc-31ba" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The first time this unit is selected to fight in each Fight phase, roll one D3 and consult the table below.</characteristic>
          </characteristics>
        </profile>
        <profile name="1 - Razor Claws" id="9e91-14bf-fa7f-4865" hidden="false" typeId="6c48-3f8e-adc6-e417" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="be9e-2b06-438b-d717">Unil the end of the phase, hideous mutations models in this unit are equipped with have an Armour Penetration characteristic of -4.</characteristic>
          </characteristics>
        </profile>
        <profile name="2 - Grasping Pseudopods" id="1291-662a-a28e-fb22" hidden="false" typeId="6c48-3f8e-adc6-e417" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="be9e-2b06-438b-d717">Until the end of the phase, models in this unit have an Attacks characteristic of 3D3.</characteristic>
          </characteristics>
        </profile>
        <profile name="3 - Toxic Haemorrhage" id="ec27-ba38-6234-b5f5" hidden="false" typeId="6c48-3f8e-adc6-e417" typeName="Mutated Beyond Reason">
          <characteristics>
            <characteristic name="Effect" typeId="be9e-2b06-438b-d717">Until the end of the phase, each time a model in this unit makes an attack, you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
