            <characteristic name="Other" typeId="c2e2-f115-0003-5d7b">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Host of the Destroyer Hive" id="9deb-6cf4-69a7-ae42" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one enemy unit within 6&quot; of this model and roll a D6; on a 2+, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of the Dead Who Walk (Aura)" id="4375-d211-b427-25a7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly POXWALKERS unit is within 6&quot; of this model, each time a model in that unit makes an attack, add 1 to the Strength characteristic of that attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Herald of Nurgle" id="c73a-dafb-d82e-ef32" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model can be included in any Death Guard Detachment, even though you cannot normally include units from two different
plague companies in the same Detachment, without preventing other units in that Detachment from carrying a Plague Company Contagion. This model can only carry a Plague Company Contagion if it is in a Harbingers Detachment.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of the Death Guard (Aura)" id="3e7f-ddcb-9ef3-4e8b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DEATH GUARD CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
