              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you roll to determine the number of attacks made with this weapon, you can re-roll the result.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Deadly Pathogens" id="d25d-b6bd-199e-b16f" hidden="false">
