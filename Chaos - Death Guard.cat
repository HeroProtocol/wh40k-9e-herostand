        <profile name="The Seven-fold Chant" id="5c3b-a6a0-4014-38bd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Command phase, if this model is on the battlefield, roll 2D6, on a 7+ you gain 1 Command point.</characteristic>
          </characteristics>
        </profile>
        <profile name="Malicious Calculation" id="70ed-2f97-06fc-6c98" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, this model can tally for one friendly &lt;PLAGUE COMPANY&gt; CORE unit within 6&quot; of it. Until the start of your next Command phase, each time a model in that unit makes an attack, add 1 to that attack&apos;s hit roll. Each unit can only be tallied for once per turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
