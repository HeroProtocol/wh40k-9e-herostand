          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- The bearer has a Save characteristic of 2+. 
- Each time an enemy unit fights, after it makes its attacks, if the bearer lost any wounds as a result of those attacks, roll one D6; on a 2+, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Harbinger of Death" id="b5c6-3412-e5d5-b424" collective="false" hidden="true" import="true" page="79" publicationId="0865-ee21-d1f1-ed38" type="upgrade">
      <constraints>
        <constraint id="4845-b809-68c1-add5" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
