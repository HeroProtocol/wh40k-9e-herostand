      <profiles>
        <profile name="Curse of the Walking Pox" id="d790-78b6-d5e7-1b4a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made by a model in this unit, if an enemy model is destroyed (excluding VEHICLE or MONSTER models), one of this unit&apos;s destroyed models is added back to it with 1 wound remaining. Models added back to this unit in this way can be set up within Engagement Range of enemy units that are already within Engagement Range of this unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fodder" id="5253-68c5-efc6-18ef" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Morale test is taken for this unit, it is automatically passed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mindless Horde" id="467e-8021-e1b1-74f4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot perform actions (excluding the Spread the Sickness action).</characteristic>
          </characteristics>
        </profile>
        <profile name="Unending Horde" id="42c8-0435-729e-05c9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit would lose a wound, roll one D6; on a 6, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
