        <profile name="Daemon Primarch" id="d118-d16b-a17e-80c1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, this model must be your army&apos;s WARLORD. If more than one model in your army has a rule to this effect, then one of these models must be your WARLORD.</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of the Death Guard (Aura)" id="e2b7-9230-f34c-6bee" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly DEATH GUARD CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
