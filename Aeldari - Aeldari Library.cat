                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Shooting phase, each time a unit with this attribute is selected to shoot, unless that unit Fell Back this turn, until the end of the phase, it counts as having Remained Stationary.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
