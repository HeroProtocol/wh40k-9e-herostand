                    <profile name="Shrine Skull" id="8499-2939-af16-efcf" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Dark Reaper Exarch model with Reaper Launcher only. If an enemy unit has any models destroyed by an attack made by the bearer, until the end of the turn, subtract 1 from Combat Attrition tests taken for that enemy unit.</characteristic>
                      </characteristics>
                    </profile>
