          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save. Each time this model makes an attack against an AIRCRAFT unit, add 1 to that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Extend Wings" id="a20d-905d-649b-fe7c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, this model can extend its wings. If it does, then until the start of your next Command phase, its Move characteristic becomes 20&quot; and it loses the Wings of Khaine, Airborne, Hard to Hit and Agile Interceptor abilities.</characteristic>
          </characteristics>
        </profile>
