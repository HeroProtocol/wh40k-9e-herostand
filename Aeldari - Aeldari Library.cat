        <profile name="The Path of Damnation" id="bf76-f717-ea7e-083a" hidden="false" page="183" publicationId="1f62-db93-63f4-4dc7" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model can never have a Relic or a Warlord Trait.</characteristic>
