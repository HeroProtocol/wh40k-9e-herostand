              <infoLinks>
                <infoLink name="Sudden Assault" id="a3e4-fd08-d256-d6ad" hidden="false" targetId="905c-8756-af7e-f223" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Autarch Jump Generator" id="b554-5eb0-abb5-77f2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has a Move characteristic of 12&quot; and gains the JUMP PACK keyword and the Warp Strike ability (see Codex: Aeldari). Each time this unit makes a Normal Move, Battle Focus move, Advances, Falls Back or makes a Charge move, until that move is finished, models in this unit can move through models and terrain features (they cannot finish a move on top of another model, or its base). When the bearer&apos;s unit makes a Battle Focus move, it can move up to 2D6&quot; instead. When determining this distance, if two or more results of 1 are made, the bearer&apos;s unit suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
