          <profiles>
            <profile name="The Lost Shroud" id="8089-fdc5-2353-7915" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">YNNARI model only. Each time an attack is allocated to the bearer:
Subtract 1 from the Damage characteristic of that attack (to a minimum of 1)
If that attack has an unmodified Damage characteristic of 1, add 1 to any armour saving throw made against that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
