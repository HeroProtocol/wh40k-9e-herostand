          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made by this model, an unmodified hit roll of 6 scores 1 additional hit. Additional attacks generated by this ability cannot benefit from the ability of this model&apos;s The Scorpion&apos;s Bite.</characteristic>
          </characteristics>
        </profile>
