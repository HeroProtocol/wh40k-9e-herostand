                      </costs>
                      <profiles>
                        <profile name="Suppressing Fire" id="b07e-b7f5-d713-0929" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Shoting phase, after this unit has shot, you can select one enemy unit that was the target of a ranged attack made by this unit&apos;s Swooping Hawks Exarch model this phase and roll 3D6. If the result is greater than that enemy unit&apos;s Leadership characteristic, until the start of your next Shooting phase that enemy unit cannot fire Overwatch, Set to Defend or perform any actions (if that unit was performing an action, that action immediately fails).</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Winged Evasion" id="5794-efbf-e2be-8e86" collective="false" hidden="false" import="true" page="109" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
                      <constraints>
