                    <profile name="Warding Runes" id="90ca-e68d-3997-07a3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models with this attribute have a 6+ invulnerable save. Each time a model with this attribute would lose a wound as a result of a mortal wound, roll one D6; on a 5+ that wound is not lost.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
