            <profile name="Saviour Stone" id="4746-abf2-e8b4-3078" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the battle round, when you make a Strands of Fate roll, if the bearer is on the battlefield, you can do one of the following;
Increase the result of one of the dice you rolled by 1 (to a maximum of 6).
Decrease the result of one of the dice you rolled by 1 (to a minimum of 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
