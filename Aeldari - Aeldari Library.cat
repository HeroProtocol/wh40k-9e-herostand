                  <profiles>
                    <profile name="Masters of Concealment" id="4385-175a-91f8-bbfd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made against a unit with this attribute, if the attacker is more than 12&quot; away, then the unit with this attribute is treated as having the benefits of Light Cover against that attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Mobile Fighters" id="5788-d3f2-5dd6-862d" collective="false" hidden="false" import="true" page="91" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
