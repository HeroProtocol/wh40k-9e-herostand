                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the LEadership characteristic of models with this attribute.
Each time a unit with this attribute is selected to fight, you can re-roll one hit roll when resolving that unit&apos;s attacks.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Masterful Shots" id="7884-53a7-a2b4-f7e0" collective="false" hidden="false" import="true" page="91" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
