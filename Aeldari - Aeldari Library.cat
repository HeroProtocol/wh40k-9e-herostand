        <profile name="Armour of Last Runes" id="954c-a96d-8c45-e966" hidden="false" page="147" publicationId="1f62-db93-63f4-4dc7" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. Each time an attack is made against this model, an unmodified wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making that attack may have.</characteristic>
          </characteristics>
        </profile>
        <profile name="First of Ulthwe" id="fa52-6fc7-d1fd-f874" hidden="false" page="147" publicationId="1f62-db93-63f4-4dc7" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Psychic test is taken for this model, you can re-roll that test.</characteristic>
          </characteristics>
        </profile>
