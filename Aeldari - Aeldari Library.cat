        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="c4b9-e21e-8f0f-73a0" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
