        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
      </costs>
      <profiles>
        <profile name="Stimm Addict" id="ad63-7047-f94d-11d0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When determining the effects of the Combat Drugs ability for this WARLORD before the battle, roll 2 additional dice, re-rolling results of 6 or results that are already in effect. This WARLORD&apos;s Combat Drugs ability has these benefits in addition to any others.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
