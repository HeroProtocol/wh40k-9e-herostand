            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="20"/>
          </costs>
          <profiles>
            <profile name="Gloom Spider" id="20c8-b81f-089b-9f36" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one enemy unit within 12&quot; of this model. Until the start of your next Command phase, enemy units cannot benefit from that enemy unit&apos;s aura abilities.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Agent of Pandemonium (Aura)" id="b966-8bc3-241a-17b3" collective="false" hidden="false" import="true" page="111" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
