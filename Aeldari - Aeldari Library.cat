                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit makes a consolidation move, if it contains a Shining Spear Exarch model, it can move an additional 6&quot;.</characteristic>
