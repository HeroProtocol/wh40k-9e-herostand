      <profiles>
        <profile name="Precision Blows" id="7614-feac-f50a-7133" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an unmodified hit roll of 6 is made for a melee attack made by this WARLORD, the target unit suffers number of mortal wounds equal to the Damage characteristic of the weapon used for that attack, and the attack sequence ends.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Stimm Addict" id="748e-efe4-b81e-f602" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
