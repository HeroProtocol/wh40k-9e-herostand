                        <profile name="Crushing Blows" id="7b95-06bc-2749-d307" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit&apos;s Striking Scorpion Exarch model makes a melee attack that targets a non-TITANIC unit, if a hit is scored, that attack automatically wounds the target.</characteristic>
                          </characteristics>
                        </profile>
