        <profile name="Treacherous Deceiver" id="3b98-3246-235b-8f19" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you make an unmodified saving throw of 4+ for this WARLORD against a melee attack, after the attacking model&apos;s unit has finished making its attacks, that enemy unit suffers 1 mortal wound. This WARLORD does not benefit from the second part of the Cursed Blades&apos; Only the Strong Will Thrive Obsession.</characteristic>
          </characteristics>
        </profile>
