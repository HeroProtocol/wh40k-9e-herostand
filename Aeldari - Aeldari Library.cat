        <profile name="Khaine Awakened (Aura)" id="703c-feec-20ff-1a57" hidden="false" page="145" publicationId="1f62-db93-63f4-4dc7" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ASURYANI CORE unit is within 12&quot; of this model, each time a Combat Attrition test is taken for that unit, you can ignore any or all modifiers.</characteristic>
          </characteristics>
        </profile>
        <profile name="Molten Form" id="0ba5-fb8b-2a84-97ab" hidden="false" page="145" publicationId="1f62-db93-63f4-4dc7" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. Each time an attack is allocated to this model, halve the Damage characteristic of that attack (rounding up).</characteristic>
          </characteristics>
        </profile>
