                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In the Fight phase, each time a model in this unit makes an attack, if this unit made a charge move this turn and contains a Shining Spear Exarch model, add 1 to that attack&apos;s hit roll.</characteristic>
                          </characteristics>
                        </profile>
