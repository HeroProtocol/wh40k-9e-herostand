          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, when a saving throw made for this Warlord is failed, you can change the Damage characteristic of that attack to 0.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="5: Mark of the Incomparable Hunter" id="53fb-8775-e6bc-36da" collective="false" hidden="false" import="true" page="119" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
