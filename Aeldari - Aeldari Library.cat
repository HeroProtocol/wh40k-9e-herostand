        <profile name="Tantalus Aethersails" id="7592-38df-615a-9f2b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model Advances, do not make an Advance roll. Instead, until the end of the phase, add 12&quot; to the Move characteristic of this model.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scything charge" id="2a43-9870-79e2-ff3d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model finishes a charge move, roll one D6 for each enemy unit within Engagement Range of it: on a 4+, that unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tantalus" id="2d61-638e-063d-115f" hidden="false" typeId="b3a8-0452-7436-44d1" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model has a transport capacity of 16 DRUKHARI INFANTRY models. Each GROTESQUE model takes the space of 2 models. This model cannot transport SCOURGES or SKYBOARD models.</characteristic>
          </characteristics>
        </profile>
