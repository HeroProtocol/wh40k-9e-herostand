            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to the Attacks characteristic of this WARLORD.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Precision Blows" id="d1be-7912-ca03-3e6f" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
