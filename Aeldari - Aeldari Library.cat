          </characteristics>
        </profile>
        <profile name="Clone Field" id="2ffb-8b94-e451-304a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Contempt for Death" id="8be8-921d-d74e-d31b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this model, halve the Damage characteristic of that attack (rounding up).</characteristic>
          </characteristics>
        </profile>
        <profile name="Master of Pain (Aura) (Urien)" id="5acb-881f-06fb-aceb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly PROPHETS OF FLESH CORE unit is within 6&quot; of any models with this ability, add 1 to the Toughness characteristic of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sculptor of Torments (Aura)" id="09ae-8aef-6f29-9888" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly PROPHETS OF FLESH CORE unit is within 6&quot; of this model, add 1 to the Strength and Leadership characteristics of models in that unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Haemovores" id="439e-defe-9114-a8af" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, roll one D6 for each enemy unit within Engagement Range of this model: on a 6, that unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fleshcraft (Urien)" id="d1d0-637e-114e-8f1a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, select one PROPHETS OF FLESH MONSTER or PROPHETS OF FLESH GROTESQUES model from your army that is within 3&quot; of this model. The model you selected regains D3 lost wounds. Each model can only be healed once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sustained by Dark Science" id="10e1-8b9b-fef1-35f4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, when this model is destroyed, you can choose to roll one D6 at the end of the phase instead of using any rules that are triggered when that model is destroyed. If you do so, then on a 2+, set this model back up on the battlefield as close as possible to where they were destroyed and not within Engagement Range of any enemy models, with D3 wounds remaining.</characteristic>
          </characteristics>
        </profile>
      </profiles>
