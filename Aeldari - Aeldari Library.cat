                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this attribute is selected to shoot or fight, you can re-roll one wound roll when resolving that unit&apos;s attacks.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
