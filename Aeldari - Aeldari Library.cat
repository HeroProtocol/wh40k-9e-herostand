  <sharedProfiles>
    <profile name="Favoured of Ynnead" id="dd92-bf1c-37ba-8951" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this Warlord piles in or consolidates, they can move up to 6&quot; instead of up to 3&quot;.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shuriken Cannon" id="e3ab-fe7e-1e15-efd8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
