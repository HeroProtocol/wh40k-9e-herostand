                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time you use the Webway Portal Stratagem (pg 69), if any units with this Obsession are selected, reduce the Command point cost of that Stratagem by 1.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Merciless Razorkin" id="b48e-6e6f-2877-d316" collective="false" hidden="false" import="true" type="upgrade">
