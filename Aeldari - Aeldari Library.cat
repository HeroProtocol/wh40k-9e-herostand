          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this model is equipped with a Harlequin&apos;s Kiss, it has the HARLEQUIN&apos;S KISS keyword. If this model is equipped with a Harlequin&apos;s Caress, it has the HARLEQUIN&apos;S CARESS keyword. If this model is equipped with a Harlequin&apos;s Embrace, it has the HARLEQUIN&apos;S EMBRACE keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="Choreographer of War (Aura)" id="0a47-49ae-774d-41d1" hidden="false" page="180" publicationId="1f62-db93-63f4-4dc7" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly HARLEQUINS CORE unit is within 6&quot; of this model, each time an attack is made by a model in that unit, re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
