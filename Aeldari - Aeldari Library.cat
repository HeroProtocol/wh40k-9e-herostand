                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes a ranged attack, the target does not receive the benefits of Light Cover against that attack.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Masters of Concealment" id="72ae-ce5a-19c7-3e0b" collective="false" hidden="false" import="true" page="91" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
                  <constraints>
