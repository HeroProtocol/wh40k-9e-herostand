                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit contains a Swooping Hawks Exarch model, this unit is eligible to shoot in a turn in which it Fell Back.</characteristic>
