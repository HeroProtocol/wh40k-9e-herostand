                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                        <cost name="pts" typeId="points" value="15"/>
                      </costs>
                      <profiles>
                        <profile name="Stand Firm" id="a3d4-4f2e-3612-0d38" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit has the Objective Secured ability. If this unit already has the Objective Secured ability, then for the purposes of determining which player controls an objective marker, each model in this unit counts as two models.
Add 1 to the Leadership characteristic of models in this unit.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Shredding Fire" id="c072-e79b-04e3-2447" collective="false" hidden="false" import="true" page="106" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
