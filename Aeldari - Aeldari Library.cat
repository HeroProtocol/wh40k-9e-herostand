                      <profiles>
                        <profile name="Shredding Fire" id="b2ed-b61b-861e-3c84" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit contains a Dire Avenger Exarch model, each time a model in this unit make a ranged attack with a shuriken weapon (pg143), the Shuriken ability takes effect on an unmodified wound roll of 5+ for that attack, instead of 6.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
