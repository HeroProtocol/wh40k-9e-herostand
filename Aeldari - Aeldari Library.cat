      </costs>
      <profiles>
        <profile name="Splintered Genius" id="cfd3-3cc1-f8fb-2676" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of the Fight phase, if this model is within Engagement Range of any enemy units, it can fight again.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Show Stealer" id="a739-bf2e-3a73-e599" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Master Succubus" id="0e90-6f01-9c80-1ad5" hidden="false" primary="false" targetId="3fa5-9569-a481-fdad"/>
