                  <profiles>
                    <profile name="Mobile Fighters" id="1012-c7d7-4bdc-0208" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this attribute makes an attack, if that model’s unit disembarked from a TRANSPORT model this turn, add 1 to that attack&apos;s wound roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Savage Blades" id="2ef8-f70f-de56-742a" collective="false" hidden="false" import="true" page="91" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
