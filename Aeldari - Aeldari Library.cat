          </conditions>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Harvester of Torment" id="e523-c5c7-f9c9-f8e9" collective="false" hidden="false" import="true" page="110" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
          <constraints>
            <constraint id="0b71-1997-68a0-d01b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ed61-86d3-587d-1961" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="40"/>
          </costs>
          <profiles>
            <profile name="Harvester of Torment" id="5310-55bb-bcd7-f6ab" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a ranged attack, an unmodified hit roll of 6 scores 3 additional hits.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rift Ghoul" id="ae30-b741-9701-3f10" collective="false" hidden="false" import="true" page="110" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
          <constraints>
            <constraint id="bb44-f529-b48e-288c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a5cc-a2b1-690b-3e7e" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="20"/>
          </costs>
          <profiles>
            <profile name="Rift Ghoul" id="0133-2c03-4107-871d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes an attack:
The target does not receive the benefits of cover against that attack.
On an unmodified wound roll of 4+, that attack inflicts 1 mortal wound on the target in addition to any normal damage.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lord of Crystal Bones" id="d795-38e2-caaa-7644" collective="false" hidden="false" import="true" page="110" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
          <constraints>
            <constraint id="16f7-b646-f72a-43d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e01a-c668-dea7-19c9" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
            <cost name="pts" typeId="points" value="20"/>
          </costs>
          <profiles>
            <profile name="Lord of Crystal Bones" id="200a-fb56-39c7-8bf2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model shoots, if any hits are scored, unless the target is a VEHICLE or MONSTER unit, until the start of your next turn:
Subtract 2&quot; from the Move characteristic of models in the target unit (to a minimum of 0&quot;).
The target cannot fire Overwatch or Set to Defend.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runes of Battle" id="f801-39da-ca0a-33b8" collective="false" hidden="false" import="true" page="123" publicationId="1f62-db93-63f4-4dc7">
      <entryLinks>
        <entryLink name="Twilight Gloom" id="5714-eee2-5476-fff6" collective="false" hidden="false" import="true" targetId="208c-8ed8-19be-39fb" type="selectionEntry">
          <constraints>
            <constraint id="9de5-991d-027c-42b7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <selectionEntries>
        <selectionEntry name="1. Conceal/Reveal" id="42ea-979b-deeb-ccf6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2179-acc8-b717-e29c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="1.1 Conceal (Blessing)" id="cfe4-a779-bbc2-baae" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one friendly &lt;CRAFTWORLD&gt; ASURYANI CORE unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, that unit receives the beenfit of Light Cover.</characteristic>
              </characteristics>
            </profile>
            <profile name="1.2 Reveal (Malediction)" id="242f-e445-147d-3e1e" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one enemy unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, each time an ASURYANI model from your army make an attack, that enemy does not receive the benefits of cover against that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="2. Embolden/Horrify" id="0921-13c5-410b-94e0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bb3d-370d-32c5-a376" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="2.1 Embolden (Blessing)" id="9b73-828e-1590-40e7" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one friendly &lt;CRATWORLD&gt; ASURYANI CORE or &lt;CRAFTWORLD&gt; ASURYANI CHARACTER unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase;
Add 2 to that unit&apos;s Leadership characteristic.
At the start of the Fight phase, if that unit is within Engagement Range of any enemy units, it can fight first that phase.</characteristic>
              </characteristics>
            </profile>
            <profile name="2.2 Horrify (Malediction)" id="6755-0568-f78b-f3dd" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one enemy unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase;
Subtract 2 from the Leadership characteristic of that unit.
At the start of the Fight phase, if that unit is within Engagement Range of any units from your army, that unit is not eligible to fight this phase until after all eligible units from your army have done so.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="3. Enhance/Drain" id="d651-60ec-b254-7835" collective="false" hidden="false" import="true" publicationId="30b2-6f64-pubN137513" type="upgrade">
          <constraints>
            <constraint id="e829-a253-3511-a784" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="3.1 Enhance (Blessing)" id="e2c3-1c7d-185a-bc31" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one friendly &lt;CRAFTWORLD&gt; ASURYANI CORE unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, each time a model in that unit makes a melee attack, add 1 to that attack&apos;s hit roll.</characteristic>
              </characteristics>
            </profile>
            <profile name="3.2 Drain (Malediction)" id="1509-0185-0ec9-0ebd" hidden="false" publicationId="30b2-6f64-pubN137513" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one enemy unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, each time a model in that unit makes a melee attack, subtract 1 from that attack&apos;s hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="4. Protect/Jinx" id="78e8-56b7-57d7-aa53" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4d3e-f3ea-8853-277d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="4.1 Protect (Blessing)" id="f103-26be-5576-c5bb" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one friendly &lt;CRAFTWORLD&gt; ASURYANI CORE unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, improve the Save characteristic of models in that unit by 1 (to a maximum of 2+).</characteristic>
              </characteristics>
            </profile>
            <profile name="4.2 Jinx (Malediction)" id="80dc-e27c-8a43-8589" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">7</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one enemy unit within 18&quot; of this PSYKER. Until the start of your next Psychic phase, worsen the Save characteristic of models in that unit by 1 (to a maximum of 6+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="5. Quicken/Restrain" id="b4e6-67c2-3336-54e2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eb80-5656-c850-a379" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
          </costs>
          <profiles>
            <profile name="5.1 Quicken (Blessing)" id="4970-d67f-0953-6250" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one friendly &lt;CRAFTWORLD&gt; ASURYANI CORE or &lt;CRAFTWORLD&gt; ASURYANI CHARACTER unit within 18&quot; of this PSYKER. That unit can immediately make a Normal Move, Advance or Fall Back as if it were the Movement phase. If it does so, that unit is not eligible to shoot or declare a charge with this turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="5.2 Restrain (Malediction)" id="9792-0330-4e7a-6e5d" hidden="false" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
              <characteristics>
                <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">6</characteristic>
                <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">18&quot;</characteristic>
                <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">Select one enemy unit within 18&quot; of this PSYKER. Until the start of your next Psychic Phase:
Halve the Move characteristic of models in that unit until.
That unit cannot perform actions (if that unit is currently performing an action, it immediately fails)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="6. Empower/Enervate" id="107a-bbf1-ed65-217c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="478d-6a95-73b8-775a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
