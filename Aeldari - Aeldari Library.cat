    <selectionEntry name="1. Calculating Gaze (Aura)" id="8979-1850-d6a5-5dbf" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="1. Calculating Gaze (Aura)" id="deef-cbc7-3b5c-1b4c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;HAEMONCULUS COVEN&gt; CORE unit is within 6&quot; of this WARLORD, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="2. Schemer Supreme" id="2f1e-f9a3-c8c4-41a8" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="2. Schemer Supreme" id="e24a-4431-0acd-e8a4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this WARLORD is on the battlefield, each time your opponent spends a Command Point to use a Stratagem you can roll one D6: on a 5+, you gain 1 Command Point.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="3. Artist of Dark Alchemy" id="f736-5255-5a37-b278" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="3. Artist of Dark Alchemy" id="e7c0-7ec9-84bf-7d53" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, after rolling to determine the number of attacks made with a weapon by a friendly &lt;HAEMONCULUS COVEN&gt; CORE model whose unit is within 6&quot; of this WARLORD, this WARLORD can use this ability. If it does so, you can re-roll the number of attacks made with that weapon and, until the end of the phase, each time you roll to determine the number of attacks made with a weapon by a model in that unit, you can re-roll the result.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
