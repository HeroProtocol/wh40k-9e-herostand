    <selectionEntryGroup name="Runes of Fortune" id="2811-a32c-6768-4a0d" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="1. Fateful Divergence" id="ca58-78b2-5a6c-d3a9" collective="false" hidden="false" import="true" page="123" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
          <constraints>
