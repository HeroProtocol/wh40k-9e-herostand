      <profiles>
        <profile name="2: Walker of Many Paths" id="1b6d-45fa-51ea-c966" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per turn, you can re-roll one hit roll, one wound roll or one damage roll made for this Warlord.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="3: Falcon&apos;s Swiftness" id="1373-b1d7-6497-7922" collective="false" hidden="false" import="true" page="119" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
      <constraints>
