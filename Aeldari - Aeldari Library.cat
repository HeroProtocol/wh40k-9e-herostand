          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="47c6-c058-daf7-1bc2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="lessThan" value="1"/>
