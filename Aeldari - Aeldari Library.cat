            <profile name="Explodes (Phantom)" id="8876-33e8-543f-b3ea" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model is destroyed, roll one D6 before removing it from play. On a 5+ it explodes, and each unit within 3D6&quot; suffers 2D6 mortal wounds.</characteristic>
