          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to this Warlord’s Move characteristic.
This Warlord can ignore the effects of the Difficult Ground terrain trait.
Each time this Warlord makes a Battle Focus move, do not roll a dice. Instead, this Warlord can move up to 6&quot;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="4: Fate&apos;s Messenger" id="12de-3cb1-1571-b410" collective="false" hidden="false" import="true" page="119" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
