                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit&apos;s Fire Dragon Exarch model makes a ranged attack that targets a VEHICLE or MONSTER unit that is within half range when this unit is selected to shoot:
If that attack is made with a Dragon Fusion Gun or Firepike, add 2 to the Damage characteristic of that attack.
If that attack is made with a Dragon&apos;s Breath Flamer, add 1 to the Damage characteristic of that attack, and when resolving the attack, you can re-roll the wound roll.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Blazing Fury" id="7c3a-2247-65d6-2174" collective="false" hidden="false" import="true" page="109" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
                      <constraints>
                        <constraint id="39c9-cb98-61f8-fb81" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
                        <cost name="pts" typeId="points" value="20"/>
                        <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                      </costs>
                      <profiles>
                        <profile name="Blazing Fury" id="fb72-e029-49a1-1ae9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit contains a Fire Dragon Exarch model, add 4&quot; to the Range characteristic of ranged weapons models in this unit are equipped with.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Burning Heat" id="9e29-1930-48a4-96f0" collective="false" hidden="false" import="true" page="109" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
                      <constraints>
                        <constraint id="6286-08e0-a751-7760" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name=" PL" typeId="e356-c769-5920-6e14" value="1"/>
