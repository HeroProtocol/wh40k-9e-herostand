      <infoLinks>
        <infoLink name="Power From Pain" id="117b-9ef1-45cc-991e" hidden="false" targetId="e6c3-8502-de0a-9515" type="rule"/>
        <infoLink name="Blade Artists" id="67e0-f265-de69-fe28" hidden="false" targetId="5145-3061-a066-4c5c" type="rule"/>
        <infoLink name="Insensible to Pain" id="0b14-9c6c-3c37-a95e" hidden="false" targetId="739a-04b0-f74a-e2a1" type="rule"/>
        <infoLink name="Driven by Fear" id="5314-f47f-31f4-ab56" hidden="false" targetId="d66d-f3ff-ec2b-46c1" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Explodes" id="cc20-cf27-0919-0be7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit is destroyed, roll a D6 before removing it from play. On a 6 it explodes, and each unit within 3&quot; suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Reservoir of Pain" id="f6c4-d726-ac89-5de5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit destroys an enemy model with its Spirit-leech tentacles, you can select this unit or one other DRUKHARI CORE unit within 6&quot; of this unit. After this unit has fought, one model in the selected unit can regain 1 lost wound (if no models in that unit have lost any wound, but the unit is not at its Starting Strength, you can instead return 1 destroyed model to that unit with one wound remaining - this model can be set up in Engagement Range of an enemy unit that is already in Engagement Range of the unit being returned to).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="1 - 3 Cronos" id="5b1f-0328-646e-0c0d" collective="false" defaultSelectionEntryId="6298-feac-6ff7-1622" hidden="false" import="true">
          <constraints>
            <constraint id="b792-026e-8289-12bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
            <constraint id="07c1-496b-5af2-e5ba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Cronos" id="6298-feac-6ff7-1622" collective="false" hidden="false" import="true" type="model">
              <costs>
