                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="In The Footsteps Of The Ancients" id="e181-b213-4676-706d" collective="false" hidden="false" import="true" page="90" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
                  <constraints>
