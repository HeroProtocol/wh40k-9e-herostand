            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">8</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">6+</characteristic>
          </characteristics>
        </profile>
        <profile name="Brides of Death (Aura) (Lelith)" id="fe17-c07d-c71e-f57a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly CULT OF STRIFE CORE unit is within 6&quot; of this model, each time a model in that unit makes a melee attack, re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Quicksilver Dodge" id="5025-8d56-aca7-3943" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. Each time a melee attack is made against this model, subtract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="At Last, a Challenge" id="8f89-13bb-7911-5bc4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a melee attack that targets a CHARACTER unit, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Natural Perfection" id="2ca0-5d03-209d-559f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one of the following:
- Thrilling Acrobatics: Until the end of the turn, this model is eligible to declare a charge in a turn in which it Fell Back or Advanced.
- Gory Spectacle: In the Fight phase of this turn, if this model destroys any enemy models, then at the end of the Fight phase, it can fight again.</characteristic>
          </characteristics>
        </profile>
        <profile name="Deadly Dance" id="e06a-b584-34fa-9354" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model makes a consolidation move, it can move an additional 3&quot;, and it does not have to finish this move closer to the closest enemy model.</characteristic>
          </characteristics>
        </profile>
        <profile name="No Escape (Lelith)" id="aedd-620b-4d62-7574" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an enemy unit (excluding TITANIC units) that is within Engagement Range of this model is selected to Fall Back, roll off with your opponent. If you win, that unit cannot fall back that turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
