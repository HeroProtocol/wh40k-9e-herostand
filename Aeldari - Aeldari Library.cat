          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 2 to this model&apos;s Attacks characteristic if it made a charge move in the same turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Insensible To Pain" id="e15f-c7e7-359a-cb15" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 5+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Court of the Archon" id="df49-a620-e780-fe4e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll failed hit rolls for this model whilst it is within 3&quot; of any friendly &lt;KABAL&gt; ARCHONS. In addition, if your army is Battle-forged, this model does not take up slots in a detachment that includes and &lt;KABAL&gt; ARCHONS.
In a Battle-forged army in a matched play game, you can only include &lt;KABAL&gt; COURT OF THE ARCHON models in a detachment that also includes one or more &lt;KABAL&gt; ARCHONS, and you can only include a maximum of 4 COURT OF THE ARCHON models in the same detachment.</characteristic>
          </characteristics>
        </profile>
      </profiles>
