          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this Warlord makes a ranged attack;
Add 1 to the Strength characteristic of that attack.
An unmodified wound roll of 6 inflicts one mortal wound on the target in addition to any normal damage.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="6: Seer of the Shifting Vector" id="7c5a-3faa-9a97-372a" collective="false" hidden="false" import="true" page="119" publicationId="1f62-db93-63f4-4dc7" type="upgrade">
      <constraints>
