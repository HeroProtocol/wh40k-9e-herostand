          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy Daemon units that are set up on the battlefield as Reinforcements cannot be set up within 12&quot; of the bearer</characteristic>
          </characteristics>
        </profile>
        <profile name="Domina Liber Demonica (Aura)" id="22d5-70da-9ba5-000c" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While an enemy Daemon unit is within 6&quot; of this model, each time a Combat Attrition test is taken for that unit, subtract 1 from that test</characteristic>
