          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Deny the Witch test is taken for the bearer, if the result of that test was an unmodified result of 8+, or it was greater than the result of the Psychic test, that Deny the Witch test passed</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
