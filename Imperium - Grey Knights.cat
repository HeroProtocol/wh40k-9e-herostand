      <rules>
        <rule name="Awaken the Machine Spirits" id="a5bd-c060-9118-e5cf" hidden="false">
          <description>In your Command phase, this model can awaken one friendly Grey Knights Vehicle model within 3&quot; of it. Until the start of your next Command phase, each time that Vehicle model makes a ranged attack, add 1 to that attack&apos;s hit roll. Each model can only be awakened once per turn</description>
        </rule>
      </rules>
