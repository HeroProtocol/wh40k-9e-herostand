            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly Grey Knights Core unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes a melee attack, add 1 to tht attack&apos;s hit roll</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Sacred Banner (Aura)" id="d311-40c0-b68a-3f8d" hidden="false">
          <description>While a friendly Paladin Core unit is within 6&quot; of this model, add 1 to the Leadership characteristic of models in that unit. In addition, while a friendly Paladin Core Infantry unit is within 6&quot; of this model, add 1 to the Attacks characteristic of models in that unit</description>
        </rule>
      </rules>
