          </modifiers>
          <profiles>
            <profile name="Candela Scroll" id="edda-1980-abdb-e361" hidden="false" page="69" publicationId="b854-bcb5-5746-e0d3" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">IMAGIFIER model only. Once per battle, in your Command phase, the bearer can unveil the Candela Scroll. If it does so, then until the start of your next Command phase, the bearer gains the following ability:

Candela Scroll (Aura): While a friendly ORDER OF OUR MARTYRED LADY CHARACTER or ORDER OF OUR MARTYRED LADY CORE unit is within 6&quot; of the bearer, add 1 to the Attacks characteristic of models in that unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
