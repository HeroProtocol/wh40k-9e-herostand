          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="95ae-23ad-4073-360a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                <condition childId="8607-5fd4-6ff6-4ef8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
