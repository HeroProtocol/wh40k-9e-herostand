                <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">*</characteristic>
                <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Each time an attack is made with this weapon, that attack automatically hits the target, and on an unmodified wound roll of 4+ (or 2+ if the target contains any DAEMON models), the target suffers 1 mortal wound and the attack sequence ends.</characteristic>
              </characteristics>
