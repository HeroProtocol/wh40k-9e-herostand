    <profile name="Bodyguard" id="cafe-6149-695a-21bd" hidden="false" page="105" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly SANCTIFIED CHARACTER or &lt;ORDER&gt; CHARACTER unit is within 3&quot; of this unit, that CHARACTER unit can use the Look Out, Sir rule even if this unit contains fewer than 3 models.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sworn Protectors" id="a731-06f5-5180-aa50" hidden="false" page="105" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this unit is within 6&quot; of a friendly &lt;ORDER&gt; CANONESS SUPERIOR, &lt;ORDER&gt; CANONESS, or &lt;ORDER&gt; PALATINE model, each time a model in this unit makes an attack, add 1 to that attack&apos;s hit roll.</characteristic>
