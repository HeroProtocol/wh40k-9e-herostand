      </characteristics>
    </profile>
    <profile name="Ecclesiarchy Battle Conclave (DCA)" id="4f4d-5726-1e03-a257" hidden="false" page="111" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
