          </conditionGroups>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Warlord Trait: Terrible Knowledge" id="a2cf-2df3-2701-b25b" hidden="false" page="61" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this WARLORD is on the battlefield, the Miracle dice you gain at the start of the first battle round is automatically a 6. While this WARLORD is on the battlefield, each time you spend a Command point to use a Stratagem you can roll one D6: on a 5+, that Command point is refunded.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
