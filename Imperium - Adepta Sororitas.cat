          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit fights, if it made a charge move this turn, then until that fight is resolved, add 1 to the Attacks characteristic of all models in this unit.</characteristic>
          </characteristics>
