              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">ADEPTA SORORITAS model only. Before you determine which sacred rite(s) are available for your army, select two sacred rites (pg 93). Until the end of the battle, these sacred rites are active for the bearer&apos;s unit instead of those that are active for the rest of your army.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
