          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">This model can transport 10 (ORDER) INFANTRY models. It cannot transport JUMP PACK models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Repressor [1] (7-12+ Wounds Remaining)" id="3be3-41ef-3564-1c93" hidden="false" publicationId="b652-8bab-1453-da20" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
