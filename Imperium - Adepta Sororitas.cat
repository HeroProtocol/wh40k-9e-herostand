              </costs>
              <profiles>
                <profile name="Divine Deliverance: Miraculous ability" id="6305-a1b3-b90b-ac54" hidden="false" page="70" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;	ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER model is within Miracle range of this model, each time that model makes a ranged attack, if that attack causes an enemy model to be destroyed, until the end of the turn, subtract 1 from that enemy unit&apos;s Leadership characteristic. A unit&apos;s Leadership characteristic cannot be reduced by more than 3 as a resuilt of this Miraculous ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
