        <profile name="Icon of Chiros" id="13e2-f469-fd51-9956" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When a Morale test is taken for a friendly Adeptus Ministorum or Astra Militarum unit whilst they are within 6&quot; of this model, roll one additional D6 and discard one of the dice.</characteristic>
          </characteristics>
        </profile>
        <profile name="Word of The Emperor" id="636a-8fa1-76f5-acfb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Roll one D6 when an Adeptus Ministorum model flees whilst its unit is within 6&quot; of any friendly models with this ability. On a 4+ that model does not flee.</characteristic>
          </characteristics>
        </profile>
      </profiles>
