      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="cc31-44af-22df-f291" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
