      </costs>
      <profiles>
        <profile name="Martyr&apos;s Strength" id="cd45-ee1e-6889-b324" hidden="false" page="68" publicationId="b854-bcb5-5746-e0d3" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">For each wound this WARLORD has lost, add 1 to its Strength and Attacks characteristic (to a maximum of +2 each).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
