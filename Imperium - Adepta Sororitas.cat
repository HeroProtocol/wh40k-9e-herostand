      <profiles>
        <profile name="Morvenn Vahl" id="e01b-c0ed-6851-5dd8" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">8&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">2+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">2+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">5</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">5</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">8</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">5</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">2+</characteristic>
          </characteristics>
        </profile>
        <profile name="Purgator Mirabilis Warsuit" id="4460-5af6-0f9e-8e7f" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. Each time this model would lose a would as the result of a mortal wound, roll one D6: on a 4+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Holy Aegis" id="0db3-cc1e-a34e-279c" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this model, halve the Damage characteristic of that attack (rounding up).</characteristic>
          </characteristics>
        </profile>
        <profile name="Abess Sanctorum (Aura)" id="5ed4-11d1-4c4a-0d79" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly ADEPTA SORORITAS CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1 and re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Commander of the Adepta Sororitas" id="b40f-e6df-e740-c811" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly ADEPTA SORORITAS CORE or ADEPTA SORORITAS CHARACTER unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll and you can re-roll the wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Righteous Repugnance" id="3fab-481e-85d3-7329" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the end of the Fight phase, if this model is within Engagement Range of any enemy units, it can fight again.</characteristic>
          </characteristics>
        </profile>
        <profile name="High Lord of the Imperium" id="37f4-d3db-bd9e-dddf" hidden="false" page="94" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, this model must be your army&apos;s WARLORD. If more than one model in your army has a rule to this effect, then one of those models must be your army&apos;s WARLORD.</characteristic>
          </characteristics>
        </profile>
      </profiles>
