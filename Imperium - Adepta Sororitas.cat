      </characteristics>
    </profile>
    <profile name="Martyrdom" id="f1cd-1a23-6fc1-2aa8" hidden="false" page="110" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If this unit is destroyed during any phase other than the Morale phase, then at the end of that phase, you gain 1 Miracle dice (pg 91).</characteristic>
      </characteristics>
    </profile>
    <profile name="Repentia Superior" id="4c4f-e03a-2e5c-e49a" hidden="false" page="109" publicationId="d124-b283-pubN72234" typeId="800f-21d0-4387-c943" typeName="Unit">
