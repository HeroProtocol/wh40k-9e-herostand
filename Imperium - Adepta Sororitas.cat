      <profiles>
        <profile name="Bodyguard" id="9cac-a4b8-c385-dd16" hidden="false" page="106" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly SANCTIFIED CHARACTER or &lt;ORDER&gt; CHARACTER unit is within 3&quot; of this unit, that CHARACTER unit can use the Look Out, Sir rule even if this unit contains fewer than 3 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Sacresant Shield" id="8f02-a5b3-bc6f-c54c" hidden="false" page="106" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models in this unit have a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Keepers of the Faith" id="e8d1-738d-e3df-1763" hidden="false" page="106" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit is eligible to perform Heroic Interventions as if it were a CHARACTER. In addition, each time this unit performs a Heroic Intervention or an enemy unit declares a charge against this unit while this unit is not within Engagement Range of any enemy units, this unit can Set to Defend. If it Sets to Defend, then until the end of the phase, it cannot fire Overwatch, but until the end of the next Fight phase, each time a model in this unit makes a melee attack, add 1 to that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
