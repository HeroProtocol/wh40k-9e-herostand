    <profile name="Solace in Anguish" id="051c-85c6-87f1-1716" hidden="false" page="110" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
