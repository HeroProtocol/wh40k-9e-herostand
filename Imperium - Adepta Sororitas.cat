        <selectionEntry name="Relic: Blade of Sacrifice" id="7a65-5294-3994-243e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d572-ccde-9efb-eec4" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
