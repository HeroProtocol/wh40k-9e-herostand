          </conditionGroups>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Warlord Trait: Shield Bearer" id="795d-8ca1-fde5-8d2b" hidden="false" page="58" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is allocated to this WARLORD, subtract 1 from the Damage characteristic of that attack (to a minimum of 1). Each time you gain a Miracle dice at the end of a phase as a result of Vengeance, if this WARLORD destroyed any enemy units during that phase, that Miracle dice is automatically a 6. Each time you gain a Miracle dice at the end of a phase as a result of Sacrifice, or if this WARLORD was destroyed during that phase, that Miracle dice is automatically a 6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
