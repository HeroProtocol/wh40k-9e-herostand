                <condition childId="8607-5fd4-6ff6-4ef8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Warlord Trait: Impervious to Pain" id="c949-c00a-530d-68f5" hidden="false" page="59" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD performs an Act of Faith, it regains 1 lost wound. Each time this WARLORD would lose a wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Warlord Trait: Shield Bearer" id="e6e8-5892-4835-7181" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="06ed-2869-0b7b-e4c9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
