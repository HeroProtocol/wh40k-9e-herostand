                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="The Emperor&apos;s Grace: Miraculous ability" id="8e2f-aa93-4150-d9ec" hidden="false" page="71" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;	ORDER&gt; CORE or &lt;ORDER&gt; CHARACTER model is within Miracle range of this model, each time an attack is made against that unit, your opponent cannot re-roll the hit roll, cannot re-roll the wound roll and cannot re-roll the damage roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
