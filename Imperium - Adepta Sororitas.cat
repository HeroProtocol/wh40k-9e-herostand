      <profiles>
        <profile name="Priest" id="c46c-8388-1284-fb92" hidden="false" page="97,103,107" publicationId="d124-b283-pubN72234" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model knows War Hymn from the Hymns of Battle. In your Command phase, if this model is on the battlefield, it can intone one hymn it knows that has not already been intended by a friendly model this turn. Roll one D6: on a 3+, the intoned hymn is inspiring and takes effect until the start of your next Command phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
