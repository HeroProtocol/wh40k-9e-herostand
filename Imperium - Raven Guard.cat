              <profiles>
                <profile name="Raven&apos;s Fury" id="579d-4e38-64e0-2ce1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">JUMP PACK model only. A model from your army with this Relic can be chosen to charge with even if they Advanced this turn.When a charge roll is made for that model, you can re-roll the dice. In addition, after that model finishes a charge move, you can select one enemy unit within 1&quot; of that model and roll one D6; on a 4+ that enemy unit suffers 1 mortal wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Oppressor&apos;s End" id="24c1-7d78-2670-2b03" collective="false" hidden="false" import="true" type="upgrade">
