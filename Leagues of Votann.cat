      <profiles>
        <profile name="Brôkhyr Iron-master" id="3996-2b84-0783-44df" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">5&quot;</characteristic>
            <characteristic name="WS" typeId="e7f0-1278-0250-df0c">3+</characteristic>
            <characteristic name="BS" typeId="381b-eb28-74c3-df5f">2+</characteristic>
            <characteristic name="S" typeId="2218-aa3c-265f-2939">4</characteristic>
            <characteristic name="T" typeId="9c9f-9774-a358-3a39">4</characteristic>
            <characteristic name="W" typeId="f330-5e6e-4110-0978">4</characteristic>
            <characteristic name="A" typeId="13fc-b29b-31f2-ab9f">3</characteristic>
            <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
            <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">4+</characteristic>
          </characteristics>
        </profile>
        <profile name="E-COG Support" id="4229-513a-e299-5f66" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit uses it&apos;s Brôkhyr&apos;s Guild ability, if this unit contains one or more E-COG models, the model being repaired regains one additional lost wound.

The destruction of an E-COG is ignored for the purposes of Morale tests. If this unit&apos;s BRÔKYR IRON-MASTER model is ever destroyed, all of this unit&apos;s remaining E-COG models are also destroyed.</characteristic>
          </characteristics>
        </profile>
        <profile name="Brôkhyr&apos;s Guild" id="0777-abd0-7a2f-a1a4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of your Movement phase, this unit can repair one friendly &lt;LEAGUE&gt; VEHICLE or &lt;LEAGUE&gt; EXO-FRAME model within 3&quot; of it. That model regains up to D3 lost wounds. Each model can only be repaired once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Multi-spectral Visor" id="1d44-7be7-ed2a-1948" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, if this unit contains a BRÔKYR IRON-MASTER model, you can select one friendly &lt;LEAGUE&gt; CORE or &lt;LEAGUE&gt; VEHICLE model within 9&quot; of this unit. If you do so, until the start of your next Command phase, each time a model in that friendly unit makes an attack with a ranged weapon, add 1 to that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
