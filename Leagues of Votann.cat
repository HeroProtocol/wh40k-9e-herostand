        </modifier>
      </modifiers>
      <profiles>
        <profile name="The Grey Crest" id="2048-958d-7eb0-8390" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- If the bearer is a CHARACTER model, each time an attack is made against the bearer, subtract 1 from that attack&apos;s hit roll.
- If the bearer is not a CHARACTER model, each time an attack is made against the bearer&apos;s unit, if the attacker is more than 12&quot; away, subtract 1 from that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
