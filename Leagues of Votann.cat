                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one friendly &lt;LEAGUE&gt; CORE unit within 6&quot; of this WARLORD. Until the start of your next Command phase, that unit has the Objective Secured ability. If a model in that unit already has this ability, that model counts as one additional model when determining control of an objective marker.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Unrelenting Toil" id="c21d-6c70-ca81-cb9b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
