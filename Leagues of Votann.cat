                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit with this custom is selected to shoot or fight, you can re-roll one hit roll or one wound roll when resolving that unit&apos;s attacks.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Weaponsmiths" id="ef72-00fe-3db9-9852" collective="false" hidden="false" import="true" type="upgrade">
