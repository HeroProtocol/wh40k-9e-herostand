          <profiles>
            <profile name="The First Knife" id="1a41-6572-dc5f-0159" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer fights, it can make one additional attack with this weapon using the close combat weapon profile. If that attack scores a hit, the target suffers D3 mortal wounds plus one additional mortal wound for each Judgement token the target unit has, and the attack sequence ends.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
