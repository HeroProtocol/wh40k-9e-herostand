                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEAGUE&gt; CORE unit that is performing an action is within 6&quot; of this WARLORD. that unit can shoot without that action failing.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
