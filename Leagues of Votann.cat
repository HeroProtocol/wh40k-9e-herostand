        <profile name="RAM Shield" id="6d16-f30d-3920-611f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a melee attack is made against this model, subtract 1 from that attack&apos;s wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mass Driver Accelerator" id="af54-fda3-f60f-e636" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this model ends a charge move, select one enemy unit within Engagement Range of this model and roll one D6. If the result is an unmodified 6, or if it equals or beats the highest Toughness characteristic in that enemy unit, that enemy unit suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Exemplar of the Einhyr (Aura)" id="7ac1-f46c-2724-e583" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;LEAGUE&gt; HEARTHGUARD unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a wound roll of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
