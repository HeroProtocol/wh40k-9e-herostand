          <selectionEntries>
            <selectionEntry name="Vengeful" id="6b90-c824-53cb-fa0a" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name=" PL" typeId="e356-c769-5920-6e14" value="0"/>
                <cost name="CP" typeId="2d3b-b544-ad49-fb75" value="0"/>
