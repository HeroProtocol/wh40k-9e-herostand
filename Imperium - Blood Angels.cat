          <modifiers>
            <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="At the end of your Movement phase, this model can heal one friendly Blood Angels Infantry or Blood Angels Biker model whose unit is within 3&quot; of it. That model regains up to D3 lost wounds. Each model can only be healed once per turn."/>
          </modifiers>
        </infoLink>
