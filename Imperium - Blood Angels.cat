        <profile name="Lord Regent of the Imperium Nihilus" id="40fd-1d94-6a28-e1d2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your army is Battle-forged, then when you select this model to be your Warlord, you receive 1 additional Command point.</characteristic>
          </characteristics>
        </profile>
        <profile name="Epic Hero of the Imperium" id="e803-f77e-ea34-d923" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, if this model is selected to use an Epic Deed Stratagem, that Stratagem costs 0 Command points.</characteristic>
          </characteristics>
        </profile>
        <profile name="Rites of Battle (Aura)" id="a73f-a19e-44be-6737" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly BLOOD ANGELS CORE unit is within 6&quot; of this model, each time a model in that unit makes an attack, re-roll a hit roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Commander Dante" id="89b2-8c59-c765-be25" hidden="false" typeId="800f-21d0-4387-c943" typeName="Unit">
          <characteristics>
            <characteristic name="M" typeId="0bdf-a96e-9e38-7779">12&quot;</characteristic>
