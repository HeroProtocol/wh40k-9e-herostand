      <profiles>
        <profile name="Chapter Master (Flesh Tearers)" id="f19c-670c-7aec-1c02" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, select one friendly FLESH TEARERS CORE or FLESH TEARERS CHARACTER unit within 6&quot; of this model. Until the start of your next Command phase, each time a model in that unit makes an attack, you can re-roll the hit roll</characteristic>
          </characteristics>
        </profile>
        <profile name="Lord of Slaughter (Aura)" id="fc87-ae75-8696-8724" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly FLESH TEARERS CORE unit is within 6&quot; of this model, each time a model in that unit makes a melee attack, on an unmodified wound roll of 6, the Damage characteristic of that attack is increased by 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Whirlwind of Gore" id="1850-b706-8b5d-292e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of the Fight phase, if this model is within Engagement Range of any enemy units, it can fight again.</characteristic>
          </characteristics>
        </profile>
