        <profile name="Death Mask of Sanguinius" id="4616-d18e-f167-99be" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time an attack is made against this model, subtract 1 from that attack’s hit roll.</characteristic>
