            <modifier field="21befb24-fc85-4f52-a745-64b2e48f8228" type="set" value="While a friendly Blood Angels Infantry or Blood Angels Biker unit is within 3&quot; of this model, each time a model in that unit would lose a wound, roll one D6: on a 6, that wound is not lost."/>
          </modifiers>
        </infoLink>
        <infoLink name="Blood Chalice" id="8106-a127-ce00-725b" hidden="false" targetId="5985-07a2-a36f-caa3" type="profile"/>
