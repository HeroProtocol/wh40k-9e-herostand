            <profile name="1. Merciless Butcher" id="fc5c-4ff4-2328-35fd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this WARLORD is selected to fight, make 1 additional attack with one of its melee weapons for every five enemy models within 3&quot; of it (to a maximum of 3 additional attacks).</characteristic>
              </characteristics>
            </profile>
