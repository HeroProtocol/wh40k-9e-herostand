          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While this model is within Engagement Range of any enemy CHARACTER models, add 1 to this model’s Strength and Attacks characteristics.</characteristic>
          </characteristics>
        </profile>
        <profile name="Slayer of Champions" id="6bc6-b2b2-fac0-7396" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Fight phase, if this model is within Engagement Range of any enemy CHARACTER units, it can fight first that phase. Each time
this model makes a melee attack against an enemy CHARACTER unit, you can re-roll the hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Armour of Faith" id="88e0-77dc-0bc2-8e18" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
