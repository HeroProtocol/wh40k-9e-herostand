        <profile name="Devout" id="b10c-cc7a-0b3f-45a0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your opponent&apos;s Psychic phase, this  unit can attempt to deny one psychic power as if it were a PSYKER</characteristic>
          </characteristics>
        </profile>
        <profile name="Spiritual Leaders (Aura)" id="b13c-cd12-ecc1-7d02" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly BLACK TEMPLARS CORE unit is within 6&quot; of this model, models in that unit can use this model’s Leadership characteristic instead of their own.</characteristic>
          </characteristics>
        </profile>
        <profile name="Indomitable Resolve" id="34cf-0225-d0f6-b26e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, when this unit&apos;s Chaplain Grimaldus model is destroyed, you can choose to roll one D6 at the end of the phase instead  of using any rules that are triggered when that model is destroyed [e.g. the Only in Death Does Duty End Strategem]. If you do then on a 4+ set this unit&apos;s Chaplain Grimaldus model back up on the battlefield as close as possible to where they were destroyedand not within Engagement range of any enemy units with 3 wounds remaining</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Cenobyte Servitors" id="e204-1a34-3d3f-9cf1" collective="false" hidden="false" import="true" type="model">
