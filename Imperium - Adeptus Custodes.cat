    </profile>
    <profile name="Gnosis (Shooting)" id="192b-0cbc-5765-3b5d" hidden="false" page="92" publicationId="1f0f-230b-a715-7d27" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
