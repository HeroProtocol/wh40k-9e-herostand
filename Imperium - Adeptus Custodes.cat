      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e0a1-2da5-324d-35c7" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="atLeast" value="1"/>
