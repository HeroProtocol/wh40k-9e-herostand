    <profile name="Anathema Psykana Rhino [3] (1-2 Wounds Remaining)" id="b38a-9ee1-23e9-5738" hidden="false" page="100" publicationId="1f0f-230b-a715-7d27" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">3&quot;</characteristic>
