                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When resolving an attack made by this Warlord against a BUILDING or VEHICLE unit, add 1 to the wound roll.</characteristic>
                  </characteristics>
