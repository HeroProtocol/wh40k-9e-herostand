            <selectionEntry name="Know Thy Enemy" id="74a3-14e7-701b-cf5b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f06a-25d5-8631-cad6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
