                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Before the battle, if your army is Battle-forged, roll one D3; you gain a number of Command Points equal to the result.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
