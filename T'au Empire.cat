      <rules>
        <rule name="Bounty Hunters" id="960b-eae2-1e55-3fd5" hidden="false">
          <description>At the start of the first battle round, select one enemy unit to be this unit’s bounty. Each time a model in this unit makes an attack against its bounty, you can re-roll the hit roll.</description>
        </rule>
        <rule name="Stealthy Hunters" id="c9db-3ff0-c710-e979" hidden="false">
          <description>Each time a ranged attack is allocated to a model in this unit while it is receiving the benefits of cover, add an additional 1 to any armour saving throw made against that attack.</description>
        </rule>
      </rules>
