    <profile name="Twin Burst Cannon" id="bd4c-312f-53b5-9512" hidden="false" page="132" publicationId="6d04-0cc1-aee0-9041" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
