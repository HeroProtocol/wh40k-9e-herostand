    <profile name="Photon Casters" id="4d28-cb60-b2b6-e1fc" hidden="false" page="206" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time this unit is declared as a target of a charge, subtract 2 from that charge&apos;s charge roll.</characteristic>
      </characteristics>
    </profile>
    <profile name="Nova Reactor (Y&apos;vahra)" id="7618-f543-d49c-1597" hidden="false" page="209" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can use this model&apos;s Nova Reactor. If you do, inflict 1 mortal wound on this model then select one of the following effects:
- Until the start of your next Command phase, this model has a 4+ invulnerable save.
- Until the start of your next Command phase, you can select the Nova profile of weapons this model is equipped with.
- Until the start of your next Command phase, add 12&quot; to the Move characteristic of this model and it is eligible to shoot in a turn in which it falls back.</characteristic>
      </characteristics>
    </profile>
    <profile name="Y&apos;vahra Shield Generator" id="ae5e-a73e-8595-fcca" hidden="false" page="209" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
