    <profile name="Positional Relay (Aura)" id="e1a0-bfed-8f5e-7c14" hidden="false" publicationId="b652-8bab-1453-da20" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">While a friendly &lt;SEPT&gt; INFANTRY unit is within 6&quot; of this model, each time that unit fights, you can re-roll one hit roll and you can re-roll one wound roll when resolving that unit&apos;s attacks.</characteristic>
      </characteristics>
    </profile>
