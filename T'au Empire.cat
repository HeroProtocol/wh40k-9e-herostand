                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this tenet makes a ranged attack with a burst weapon (pg 130) that targets a unit within 12&quot;, add 1 to that attack&apos;s hit roll.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
