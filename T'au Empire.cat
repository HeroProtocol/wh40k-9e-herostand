    <profile name="Twin T&apos;au Flamer" id="216d-4eb6-e932-7bcd" hidden="false" page="132" publicationId="6d04-0cc1-aee0-9041" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
