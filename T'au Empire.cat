    <profile name="Piranha Fusion Blaster" id="f65e-3707-1529-06bc" hidden="false" page="131" publicationId="6d04-0cc1-aee0-9041" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
