        <characteristic name="S" typeId="59b1-319e-ec13-d466">+1</characteristic>
        <characteristic name="AP" typeId="75aa-a838-b675-6484">-1</characteristic>
        <characteristic name="D" typeId="ae8a-3137-d65b-4ca7">2</characteristic>
        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">-</characteristic>
      </characteristics>
    </profile>
    <profile name="Flare Launcher" id="9dfd-e01b-00f8-37fd" hidden="false" page="114" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer would lose a wound as a result of a ranged attack with a Strength characteristic of 7 or more, roll one D6: on a 5+, that wound is not lost.</characteristic>
      </characteristics>
    </profile>
    <profile name="Explodes (Ghostkeel)" id="6e07-84d8-dbf4-b00e" hidden="false" page="114" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this unit&apos;s GHOSTKEEL BATTLESUIT model is destroyed, roll one D6 before removing it from play. On a 6 it explodes, and each unit within 6&quot; suffers D3 mortal wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="Stingwing Claws" id="f3d9-ff59-96d7-7c51" hidden="false" page="130" publicationId="6d04-0cc1-aee0-9041" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
