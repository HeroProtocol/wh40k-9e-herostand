                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this tenet (excluding DRONE models) would lose a wound as the result of a mortal wound, roll one D6: on a 5+, that wound is not lost.</characteristic>
                      </characteristics>
