        <characteristic name="Abilities" typeId="837d-5e63-aeb7-1410">Blast. This weapon can target units that are not visible to the bearer.</characteristic>
      </characteristics>
    </profile>
    <profile name="High Intensity Markerlights" id="5d90-07cd-c29c-7db4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model in this unit performs the Fire Markerlights action (see Codex: T’au Empire), roll two additional D6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Supreme Honour Blade" id="a576-14fd-32d6-49de" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Melee</characteristic>
