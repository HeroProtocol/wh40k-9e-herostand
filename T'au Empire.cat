        <characteristic name="Ld" typeId="00ca-f8b8-876d-b705">9</characteristic>
        <characteristic name="Save" typeId="c0df-df94-abd7-e8d3">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Hover (Manta)" id="3a0d-bc1c-df09-4b87" hidden="false" page="213" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, this model can hover, if it does, then until the start of your next Command phase, it&apos;s Move characteristic becomes 20&quot; and it loses the Airborne, Hard to Hit and Supersonic abilities.</characteristic>
      </characteristics>
    </profile>
    <profile name="Explodes (Manta)" id="4197-3293-87fd-3b8d" hidden="false" page="213" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When this model is destroyed, roll one D6 before removing it from play. On a 4-5, it explodes, and each unit within 2D6&quot; suffers D6 mortal wounds. On a 6, it explodes, and each unit within 3D6&quot; suffers 2D3 mortal wounds.</characteristic>
      </characteristics>
    </profile>
    <profile name="Energy Shield" id="e3b5-1598-d61a-99e5" hidden="false" page="213" publicationId="7573-8d1b-acdf-2de8" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Blacklight Marker Drone" id="464f-9148-5afd-1171" hidden="false" page="205" publicationId="7573-8d1b-acdf-2de8" typeId="800f-21d0-4387-c943" typeName="Unit">
      <characteristics>
        <characteristic name="M" typeId="0bdf-a96e-9e38-7779">8&quot;</characteristic>
        <characteristic name="WS" typeId="e7f0-1278-0250-df0c">5+</characteristic>
        <characteristic name="BS" typeId="381b-eb28-74c3-df5f">4+</characteristic>
