      </characteristics>
    </profile>
    <profile name="Piranha Burst Cannon" id="9255-7e87-e52b-affc" hidden="false" page="131" publicationId="6d04-0cc1-aee0-9041" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
