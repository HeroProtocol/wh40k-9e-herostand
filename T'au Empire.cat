    <profile name="Velocity Tracker" id="59a3-4254-c6b0-d8f9" hidden="false" page="100" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack is made by the bearer against a unit that can FLY, add 1 to that attack&apos;s hit roll. Maximum 1 per model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Target Lock" id="a0a8-a8a5-102d-cc19" hidden="false" page="100" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer makes a ranged attack, the target does not receive the benefits of Light Cover against that attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shield Generator" id="8f1c-39b1-296b-39ef" hidden="false" page="99,100" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has a 4+ invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Multi-tracker" id="52ad-81b1-cccd-614b" hidden="false" page="100" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a ranged attack made by the bearer targets a unit containing 6 or more models, an unmodified hit roll of 6 scores 1 additional hit. Maximum 1 per model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Early Warning Override" id="a8f2-944e-8ce8-80b6" hidden="false" page="100" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">- Each time the bearer fires Overwatch, it scores hits on unmodified hit rolls of 5+, instead of 6.
- Each time you use the Fire Overwatch Stratagem, if the bearer is on the battlefield and its unit is selected to fire Overwatch, reduce the CP cost of that Stratagem by 1CP (to a minimum of 0CP). Note that the CP cost is only reduced by 1CP for that use of the Stratagem, any future usages of it cost the normal amount of CPs.</characteristic>
      </characteristics>
    </profile>
    <profile name="Drone Controller" id="a54e-6d37-c134-efc4" hidden="false" page="113" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In your Command phase, you can select one DRONE unit within 6&quot; of the bearer, until the start of your next Command phase:
- DRONE models in that unit have a Ballistic Skill characteristic of 4+.
- GUN DRONE models in that unit lose the Drone Identification Protocol ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Counterfire Defence System" id="50f1-ace8-3345-0725" hidden="false" page="100" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer gains the COUNTERFIRE DEFENCE SYSTEM keyword.</characteristic>
      </characteristics>
    </profile>
    <profile name="Advanced Targeting System" id="4d48-1d09-dda7-a541" hidden="false" page="119" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time the bearer makes a ranged attack, an unmodified hit roll of 6 automatically wounds the target.</characteristic>
      </characteristics>
    </profile>
