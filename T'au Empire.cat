    <profile name="Advanced Guardian Shield Generator" id="a2ef-0829-eb0d-e0de" hidden="false" page="95" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This model has a 4+ invulnerable save. This unit cannot be selected as a target for ranged attacks unless it is the closest eligible target to the firing model.</characteristic>
      </characteristics>
    </profile>
    <profile name="Command-link" id="5671-12fc-bbd0-7d1c" hidden="false" page="95" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 3&quot; to the range of this unit&apos;s aura abilities (to a maximum of 12&quot;). Each time a model in this unit uses an ability in your Command phase (excluding aura abilities), add 3&quot; to the range of that ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Stealth Field Generator" id="8da4-c548-bf38-a020" hidden="false" page="97" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This unit cannot be selected as a target for ranged attacks unless it is the closest eligible target to the firing model or the firing model is within 18&quot; of it.</characteristic>
      </characteristics>
    </profile>
