                  <profiles>
                    <profile name="Evasion Manoeuvres" id="a1f8-ff20-be56-968f" hidden="false" page="64" publicationId="6d04-0cc1-aee0-9041" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Abilities">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a model with this tenet Advances, until the start of your next Movement phase, models in that unit that can FLY have a 5+ invulnerable save against ranged attacks.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Pinpoint Targeting" id="a952-e769-4114-c457" collective="false" hidden="false" import="true" type="upgrade">
